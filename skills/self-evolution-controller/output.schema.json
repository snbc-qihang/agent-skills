    "language": {
      "type": "string"
    },
    "document_metadata": {
      "type": "object"
    },
    "required_information_requests": {
      "type": "array"
    },
    "status": {
      "type": "string"
    },
    "artifacts": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "gate_decision": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
