{
  "registry_version": 1,
  "capability_id": "multi_window_coordination",
  "run_id": "mw-example-001",
  "project": {
    "name": "example-project",
    "repo_path": "/absolute/path/to/repo",
    "branch": "example-branch",
    "goal": "example development goal"
  },
  "user_required_inputs": {
    "project_path": "confirmed",
    "target_branch": "confirmed",
    "business_goal": "confirmed",
    "in_scope": "confirmed",
