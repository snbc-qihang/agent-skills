    "acceptance_criteria": "confirmed",
    "test_environment": "confirmed",
    "window_creation_authorized": "confirmed",
    "write_permission": "confirmed",
    "worktree_allowed": "confirmed"
  },
  "window_reuse_policy": {
    "default": "reuse_registered_window_first",
    "recreate_only_when": [
      "thread_not_found",
      "thread_inaccessible",
      "host_unavailable_and_handoff_failed",
      "window_role_or_module_scope_unrecoverable",
      "user_explicitly_requests_recreate"
    ],
    "never_recreate_when": [
      "window_is_idle",
      "window_has_old_context_but_same_role_and_module",
      "window_title_changed_but_threadId_is_valid"
    ]
  },
  "authoritative_input_policy": {
    "old_window_context_policy": "historical_only",
    "must_not_reuse_unverified_prior_conclusions": true,
    "inputs": [
      "approved_requirements.md",
      "approved_business-rules.md",
      "approved_architecture-design.md",
      "module-task-brief.md",
      "allowed-files.json",
      "forbidden-scope.json"
    ]
  },
  "controller_window": {
    "threadId": "controller-thread-id",
    "name": "主控窗口",
    "role": "controller",
    "responsibilities": [
      "task decomposition",
      "window registry maintenance",
      "dispatch",
      "status reading",
      "final summary"
    ]
  },
  "documents": {
    "required_information_requests": {
      "path": "artifacts/required-information-requests.json",
      "status": "approved"
    },
    "requirement_doc": {
      "path": "artifacts/requirements.md",
      "owner_window": "产品经理窗口",
      "status": "approved"
    },
    "business_doc": {
      "path": "artifacts/business-rules.md",
