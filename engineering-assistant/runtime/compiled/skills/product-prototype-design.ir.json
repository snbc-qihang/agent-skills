{
  "skill_id": "product-prototype-design",
  "version": "1.1.0",
  "stage": "product_prototype_design",
  "type": "stage_skill",
  "prompt_pack": {
    "display_name": "Product Prototype Design",
    "short_description": "为 web/app 产品研发生成可评审的高保真原型合同、视觉证据和交互状态映射，作为后续设计与实现的硬门禁。",
    "default_prompt": "使用 product-prototype-design，先完成 preflight 信息梳理；preflight_input_state 不是 ready 时仅生成 required_information_requests、human-review HTML 和恢复点，补齐写回后再进入 formal_generation 输出声明产物与 gate decision。",
    "trigger_description": "Use when Web/App 产品任务缺少可作为实现事实源的高保真原型时；Do not use when do not把低保真线框图、接口说明或组件清单当成产品原型通过。",
    "language_policy": {
      "supported": [
        "zh-CN",
        "en"
      ],
      "when_unspecified": "ask_user"
    },
    "preflight_gate": {
      "states": [
        "ready",
        "waiting_for_input",
        "waiting_for_human_review",
        "blocked"
      ],
      "formal_generation_entry_condition": "preflight_input_state == ready"
    }
  },
  "inputs": [
    "requirement-contract.json",
    "repo-context-report.md",
    "brand_or_design_system_context",
    "target_viewports"
  ],
  "outputs": [
    "product-prototype-contract.json",
    "prototype-source.md",
    "desktop-prototype-screenshot.png",
    "mobile-prototype-screenshot.png",
    "interaction-state-map.json",
    "third-party-capability-ledger.json"
  ],
  "routing": {
    "intent_tags": [
      "design",
      "product",
      "product-prototype-design",
      "product_prototype_design",
      "prototype",
      "stage_skill",
      "web/app",
      "产品研发生成可评审的高保真原型合同",
      "作为后续设计与实现的硬门禁。",
      "视觉证据和交互状态映射"
    ],
    "positive_triggers": [
      "product-prototype-design",
      "Product Prototype Design",
      "为 web/app 产品研发生成可评审的高保真原型合同、视觉证据和交互状态映射，作为后续设计与实现的硬门禁。"
    ],
    "negative_triggers": [
      "只解释 Product Prototype Design 的用途，不执行任务",
      "只咨询说明",
      "不生成产物"
    ],
    "requires": [
      "requirement-contract.json",
      "repo-context-report.md",
      "brand_or_design_system_context",
      "target_viewports"
    ],
    "conflicts_with": [],
    "risk_level": "medium",
    "cost_class": "medium",
    "evidence_required": [
      "高保真原型存在",
      "桌面和移动截图存在",
      "核心用户流完整",
      "加载/空态/错误态/权限态完整",
      "第三方能力调用已登记"
    ],
    "allow_implicit_invocation": true
  },
  "risk": {
    "risk_level": "medium",
    "allow_implicit_invocation": true,
    "human_approval_required": [
      "跳过原型门禁",
      "使用非项目既有设计系统",
      "核心信息架构变更"
    ]
  },
  "quality_gates": [
    "高保真原型存在",
    "桌面和移动截图存在",
    "核心用户流完整",
    "加载/空态/错误态/权限态完整",
    "第三方能力调用已登记"
  ],
  "workflow": {
    "node_id": "product-prototype-design",
    "entry_modes": [
      "auto_flow",
      "from_node",
      "single_node"
    ],
    "next_nodes": []
  },
  "source_files": [
    "skills/product-prototype-design/SKILL.md",
    "skills/product-prototype-design/contract.yaml",
    "skills/product-prototype-design/workflow/node.yaml",
    "skills/product-prototype-design/agents/openai.yaml"
  ]
}
