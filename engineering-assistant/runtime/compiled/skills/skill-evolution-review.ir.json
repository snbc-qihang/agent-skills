{
  "skill_id": "skill-evolution-review",
  "version": "3.1.0",
  "stage": "skill_evolution_review",
  "type": "audit_skill",
  "prompt_pack": {
    "display_name": "Skill Evolution Review",
    "short_description": "将已采集反馈事件转化为可评审的 skill 改进候选、回归 eval 候选、治理规则候选和拒绝入库原因。",
    "default_prompt": "使用 skill-evolution-review，先确认语言和必填输入，再输出声明产物与 gate decision。",
    "trigger_description": "Use when 周期性消费 feedback inbox，需要聚类为 skill patch、eval regression 或治理规则候选时；Do not use when do not未经人工审批自动修改正式 SKILL.md、contract、workflow 或 schema。",
    "language_policy": {
      "supported": [
        "zh-CN",
        "en"
      ],
      "when_unspecified": "ask_user"
    }
  },
  "inputs": [
    "feedback-inbox.json",
    "feedback-event.json",
    "engineering-lessons.md",
    "skill registry"
  ],
  "outputs": [
    "skill-evolution-report.md",
    "skill-evolution-candidates.json",
    "skill-patch-proposals.json",
    "regression-case-candidates.yaml",
    "feedback-rejection-log.json"
  ],
  "routing": {
    "intent_tags": [
      "audit_skill",
      "eval",
      "evolution",
      "review",
      "skill",
      "skill-evolution-review",
      "skill_evolution_review",
      "候选",
      "回归",
      "将已采集反馈事件转化为可评审的",
      "改进候选",
      "治理规则候选和拒绝入库原因。"
    ],
    "positive_triggers": [
      "skill-evolution-review",
      "Skill Evolution Review",
      "将已采集反馈事件转化为可评审的 skill 改进候选、回归 eval 候选、治理规则候选和拒绝入库原因。"
    ],
    "negative_triggers": [
      "只解释 Skill Evolution Review 的用途，不执行任务",
      "只咨询说明",
      "不生成产物"
    ],
    "requires": [
      "feedback-inbox.json",
      "feedback-event.json",
      "engineering-lessons.md",
      "skill registry"
    ],
    "conflicts_with": [],
    "risk_level": "high",
    "cost_class": "high",
    "evidence_required": [
      "每个候选有来源事件",
      "accept/reject verdict 明确",
      "重复用户纠正已生成回归候选",
      "正式 skill 修改需要人工审批"
    ],
    "allow_implicit_invocation": false
  },
  "lean_runtime_router_policy": {
    "schema": "engineering-assistant/schemas/runtime-route-decision.schema.json",
    "task_kinds": [
      "context",
      "audit",
      "change",
      "release",
      "self_healing"
    ],
    "evidence_levels": [
      "inline",
      "lite",
      "standard",
      "formal"
    ],
    "persistence_modes": [
      "inline",
      "ephemeral",
      "target_repo",
      "blocked"
    ],
    "default_persistence_mode": "ephemeral",
    "capability_decision_required": true,
    "assistant_feedback_required": true,
    "assistant_feedback_schema": "engineering-assistant/schemas/assistant-run-feedback.schema.json",
    "document_spine_required": true,
    "planning_spine_schema": "engineering-assistant/schemas/planning-spine.schema.json",
    "engineering_governance_state_machine_required": true,
    "capability_routing_protocol_required": true,
    "documentation_output_mode": "control_surface_first",
    "quality_contract_runner_required": true,
    "quality_contract_runner": "engineering-assistant/scripts/run_quality_contract.py",
    "agent_execution_monitor_schema": "engineering-assistant/schemas/agent-execution-monitor.schema.json",
    "post_task_plan_alignment_required": true,
    "post_task_plan_alignment_schema": "engineering-assistant/schemas/post-task-plan-alignment.schema.json",
    "prototype_review_required_for_frontend_products": true,
    "product_prototype_contract_schema": "engineering-assistant/schemas/product-prototype-contract.schema.json",
    "prototype_review_report_schema": "engineering-assistant/schemas/prototype-review-report.schema.json",
    "feedback_event_schema": "engineering-assistant/schemas/feedback-event.schema.json",
    "skill_evolution_candidate_schema": "engineering-assistant/schemas/skill-evolution-candidate.schema.json",
    "policy_source": "workflow-orchestrator.workflow_runtime_policy.lean_runtime_router_policy",
    "full_policy_required_for": false
  },
  "engineering_governance_state_machine": {
    "model_name": "engineering-governance-v2",
    "positioning": "engineering-assistant 保留软件工程方法论主控权；Codex、Hermes、skills 和 MCP 是可委派执行能力，不替代工程状态、边界、门禁和验收责任。",
    "default_stage_model": [
      "intake",
      "context_modeling",
      "architecture_boundary",
      "implementation_contract",
      "controlled_execution",
      "quality_verification",
      "review_and_release",
      "retrospective_learning"
    ],
    "stage_contracts": {
      "intake": [
        "requirement_contract",
        "scope_and_non_goals",
        "acceptance_criteria",
        "blocking_questions"
      ],
      "context_modeling": [
        "repo_context",
        "module_map",
        "reusable_capabilities",
        "impact_scope"
      ],
      "architecture_boundary": [
        "system_boundary",
        "data_flow",
        "interface_contract",
        "risk_decisions"
      ],
      "implementation_contract": [
        "allowed_modules",
        "forbidden_modules",
        "quality_commands",
        "traceability_matrix"
      ],
      "controlled_execution": [
        "changed_files",
        "delegated_capability_ledger",
        "repair_attempts",
        "control_health"
      ],
      "quality_verification": [
        "test_evidence",
        "build_evidence",
        "browser_or_runtime_evidence",
        "gate_decision"
      ],
      "review_and_release": [
        "findings",
        "approval_requests",
        "release_readiness",
        "rollback_plan"
      ],
      "retrospective_learning": [
        "lessons",
        "rule_candidates",
        "skill_improvement_candidates"
      ]
    },
    "required_control_surface": [
      "current-task.json",
      "current-subtask.json",
      "artifact-index.json",
      "open-questions.json",
      "quality-contract.json",
      "quality-run-report.json",
      "implementation-contract.json",
      "traceability-matrix.json",
      "capability-invocation-ledger.json",
      "control-health-report.json"
    ],
    "hard_rules": [
      "设计阶段可以裁剪，但不得跳过需求边界、影响范围、质量命令和阻断问题判断。",
      "长期任务恢复必须先读取目标项目 artifacts/_control/ 机读控制面，不得用聊天记忆或历史长文档替代。",
      "委派工具完成执行后，engineering-assistant 必须消费其证据并作 gate decision；子工具自述成功不是通过证据。",
      "缺少关键能力时必须按能力协议降级或阻断，不得伪造浏览器、代码图谱、CI、GitHub 或生产状态。"
    ]
  },
  "capability_routing_protocol": {
    "principle": "先用软件工程状态机确定阶段、边界和验收，再选择最合适执行能力；委派不转移工程责任。",
    "decision_values": [
      "use_native_codex",
      "delegate",
      "fallback",
      "block",
      "skip"
    ],
    "capabilities": {
      "codebase_analysis": {
        "preferred": [
          "codegraph"
        ],
        "fallback": [
          "rg",
          "targeted_file_reads",
          "compiler_or_test_feedback"
        ],
        "missing_behavior": "continue_with_lower_confidence",
        "required_evidence": [
          "queried_symbols_or_files",
          "impact_scope",
          "confidence_note"
        ]
      },
      "frontend_product_execution": {
        "preferred": [
          "build-web-apps",
          "browser",
          "chrome"
        ],
        "fallback": [
          "repo_native_frontend_stack",
          "playwright_or_local_render_check"
        ],
        "missing_behavior": "block_browser_level_acceptance",
        "required_evidence": [
          "product_ia",
          "state_coverage",
          "desktop_mobile_render_evidence",
          "console_error_check",
          "core_workflow_interaction"
        ],
        "claim_boundaries": {
          "without_browser_capability": "code_level_validation_only",
          "with_browser_evidence": "frontend_product_acceptance_allowed",
          "missing_browser_evidence": "frontend_product_acceptance_blocked"
        }
      },
      "github_pr_ci": {
        "preferred": [
          "github"
        ],
        "fallback": [
          "local_git_diff",
          "local_quality_commands"
        ],
        "missing_behavior": "do_not_claim_remote_pr_or_ci_state",
        "required_evidence": [
          "local_diff",
          "commands_run",
          "remote_state_if_available"
        ]
      },
      "security_or_production": {
        "preferred": [
          "security_tools",
          "human_approval"
        ],
        "fallback": [],
        "missing_behavior": "block_until_review",
        "required_evidence": [
          "approval_record",
          "risk_assessment",
          "rollback_or_mitigation"
        ]
      }
    },
    "ledger_artifact": "artifacts/_control/capability-invocation-ledger.json",
    "health_artifact": "artifacts/_control/capability-health.json",
    "block_markers": [
      "CAPABILITY_REQUIRED_BUT_UNAVAILABLE",
      "DELEGATED_OUTPUT_UNVERIFIED",
      "REMOTE_STATE_UNPROVEN"
    ]
  },
  "documentation_output_mode_policy": {
    "default_mode": "control_surface_first",
    "formal_document_mode": "on_human_review_or_audit_need",
    "required_by_default": [
      "machine_readable_contracts",
      "open_questions",
      "quality_commands",
      "traceability",
      "gate_decision",
      "capability_ledger"
    ],
    "optional_by_default": [
      "long_markdown_design",
      "stage_summary",
      "human_readable_html",
      "workflow_summary",
      "handoff_narrative"
    ],
    "promotion_rule": "长文档只有在人类评审、交接、审计、合规或用户明确要求时生成或提升到 docs/；否则保持为 .run-artifacts 或 artifacts/_control 的机读事实。",
    "control_preservation_rule": "减少长文档不能减少控制能力；任何裁剪必须保留当前任务、范围、阻断问题、质量命令、变更追踪和验收证据。"
  },
  "runtime_rule_markers": [
    "ACTIVE_CONTEXT_OVER_BUDGET",
    "ASSISTANT_FEEDBACK_NOT_CONSUMED_BY_AGENT",
    "ASSISTANT_FEEDBACK_NOT_GENERATED",
    "CAPABILITY_HEALTH_NOT_CHECKED",
    "CAPABILITY_REQUIRED_BUT_UNAVAILABLE",
    "CONTROL_SURFACE_FIRST_VIOLATED",
    "DELEGATED_OUTPUT_UNVERIFIED",
    "DOC_SPRAWL_RISK",
    "ENGINEERING_GOVERNANCE_STATE_NOT_ESTABLISHED",
    "MISSING_POST_TASK_ALIGNMENT",
    "PROCESS_DOCUMENTATION_POLLUTION",
    "PRODUCT_PLAN_DRIFT",
    "REMOTE_STATE_UNPROVEN",
    "TARGET_REPO_ARTIFACT_POLLUTION"
  ],
  "risk": {
    "risk_level": "high",
    "allow_implicit_invocation": false,
    "human_approval_required": [
      "应用 skill patch",
      "新增强制 eval",
      "修改 workflow 或 quality gate",
      "发布插件版本"
    ]
  },
  "quality_gates": [
    "每个候选有来源事件",
    "accept/reject verdict 明确",
    "重复用户纠正已生成回归候选",
    "正式 skill 修改需要人工审批"
  ],
  "workflow": {
    "node_id": "skill-evolution-review",
    "entry_modes": [
      "auto_flow",
      "from_node",
      "single_node"
    ],
    "next_nodes": []
  },
  "source_files": [
    "skills/skill-evolution-review/SKILL.md",
    "skills/skill-evolution-review/contract.yaml",
    "skills/skill-evolution-review/workflow/node.yaml",
    "skills/skill-evolution-review/agents/openai.yaml"
  ]
}
