{
  "skill_id": "skill-evolution-review",
  "version": "1.1.0",
  "stage": "skill_evolution_review",
  "type": "audit_skill",
  "prompt_pack": {
    "display_name": "Skill Evolution Review",
    "short_description": "将已采集反馈事件转化为可评审的 skill 改进候选、回归 eval 候选、治理规则候选和拒绝入库原因。",
    "default_prompt": "使用 skill-evolution-review，先完成 preflight 信息梳理；preflight_input_state 不是 ready 时仅生成 required_information_requests、human-review HTML 和恢复点，补齐写回后再进入 formal_generation 输出声明产物与 gate decision。",
    "trigger_description": "Use when 周期性消费 feedback inbox，需要聚类为 skill patch、eval regression 或治理规则候选时；Do not use when do not未经人工审批自动修改正式 SKILL.md、contract、workflow 或 schema。",
    "language_policy": {
      "supported": [
        "zh-CN",
        "en"
      ],
      "when_unspecified": "ask_user"
    },
    "preflight_gate": {
      "states": [
        "ready",
        "waiting_for_input",
        "waiting_for_human_review",
        "blocked"
      ],
      "formal_generation_entry_condition": "preflight_input_state == ready"
    }
  },
  "inputs": [
    "feedback-inbox.json",
    "feedback-event.json",
    "engineering-lessons.md",
    "skill registry"
  ],
  "outputs": [
    "skill-evolution-report.md",
    "skill-evolution-candidates.json",
    "skill-patch-proposals.json",
    "regression-case-candidates.yaml",
    "feedback-rejection-log.json"
  ],
  "routing": {
