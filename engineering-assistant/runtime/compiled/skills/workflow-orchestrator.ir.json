{
  "skill_id": "workflow-orchestrator",
  "version": "1.1.0",
  "stage": "workflow_orchestration",
  "type": "workflow_skill",
  "prompt_pack": {
    "display_name": "Workflow Orchestrator",
    "short_description": "支持阶段选择、全链路 workflow、状态机、错误处理、审批暂停/恢复、产物传递和 trace 记录。",
    "default_prompt": "使用 workflow-orchestrator，先完成 preflight 信息梳理；preflight_input_state 不是 ready 时仅生成 required_information_requests、human-review HTML 和恢复点，补齐写回后再进入 formal_generation 输出声明产物与 gate decision。",
    "trigger_description": "Use when 需要选择研发 workflow、串联 stage skills、维护状态机、审批暂停/恢复和产物路由时；Do not use when do not直接生成某个阶段文档。",
    "language_policy": {
      "supported": [
        "zh-CN",
        "en"
      ],
      "when_unspecified": "ask_user"
    },
    "preflight_gate": {
      "states": [
        "ready",
        "waiting_for_input",
        "waiting_for_human_review",
        "blocked"
      ],
      "formal_generation_entry_condition": "preflight_input_state == ready"
    }
  },
  "inputs": [
    "workflow.yaml",
    "stage node registry",
    "StageRunRequest",
    "approval_context"
  ],
  "outputs": [
    "workflow-trace.json",
    "workflow-summary.md",
    "approval-requests.json",
    "artifact-index.json",
    "validator-summary.json",
    "information-inventory.json",
    "context-source-map.json",
    "missing-information-list.json",
    "design-objective-plan.md",
    "scope-and-non-goals.yaml",
    "user-confirmed-facts.json",
    "design-direction-decision.md",
    "assumption-and-decision-log.yaml",
    "self-review-findings.json",
    "auto-fix-report.json",
    "unresolved-review-findings.json",
    "human-review-package.json",
    "human-review-feedback.json",
    "feedback-classification.json",
    "next-iteration-plan.md",
    "iteration-trace.json",
    "rule-candidates.json",
    "prompt-optimization-candidates.md",
    "tl-review-package.json"
  ],
