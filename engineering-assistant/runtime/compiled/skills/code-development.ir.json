{
  "skill_id": "code-development",
  "version": "1.0.0.4",
  "stage": "code_development",
  "type": "stage_skill",
  "prompt_pack": {
    "display_name": "Code Development",
    "short_description": "基于设计文档进行最小必要代码变更或生成代码修改计划。",
    "default_prompt": "使用 code-development，先确认语言和必填输入，再输出声明产物与 gate decision。",
    "trigger_description": "Use when the request is about 基于设计文档进行最小必要代码变更或生成代码修改计划。；Do not use when 不修改无关模块；不绕过测试。",
    "language_policy": {
      "supported": [
        "zh-CN",
        "en"
      ],
      "when_unspecified": "ask_user"
    }
  },
  "inputs": [
    "detailed-design.md",
    "implementation-plan.md",
    "interface-contracts.yaml",
    "repo_context"
  ],
  "outputs": [
    "code changes",
    "implementation-summary.md",
    "design-to-code-mapping.yaml",
    "changed-files-report.json",
    "traceability-matrix.json"
  ],
  "routing": {
    "intent_tags": [
      "code",
      "code-development",
      "code_development",
      "development",
      "stage_skill",
      "基于设计文档进行最小必要代码变更或生成代码修改计划。"
    ],
    "positive_triggers": [
      "code-development",
      "Code Development",
      "基于设计文档进行最小必要代码变更或生成代码修改计划。"
    ],
    "negative_triggers": [
      "只解释 Code Development 的用途，不执行任务",
      "只咨询说明",
      "不生成产物"
    ],
    "requires": [
      "detailed-design.md",
      "implementation-plan.md",
      "interface-contracts.yaml",
      "repo_context"
    ],
    "conflicts_with": [],
    "risk_level": "high",
    "cost_class": "high",
    "evidence_required": [
      "每个变更映射到设计",
      "无无关模块修改",
      "高风险文件已标记",
      "测试命令已列出",
      "需求-设计-代码追踪矩阵已刷新"
    ],
    "allow_implicit_invocation": false
  },
  "lean_runtime_router_policy": {
    "schema": "engineering-assistant/schemas/runtime-route-decision.schema.json",
    "task_kinds": [
      "context",
      "audit",
      "change",
      "release",
      "self_healing"
    ],
    "evidence_levels": [
      "inline",
      "lite",
      "standard",
      "formal"
    ],
    "persistence_modes": [
      "inline",
      "ephemeral",
      "target_repo",
      "blocked"
    ],
    "default_persistence_mode": "ephemeral",
    "capability_decision_required": true,
    "assistant_feedback_required": true,
    "assistant_feedback_schema": "engineering-assistant/schemas/assistant-run-feedback.schema.json",
    "document_spine_required": true,
    "planning_spine_schema": "engineering-assistant/schemas/planning-spine.schema.json",
    "engineering_governance_state_machine_required": true,
    "capability_routing_protocol_required": true,
    "documentation_output_mode": "control_surface_first",
    "quality_contract_runner_required": true,
    "quality_contract_runner": "engineering-assistant/scripts/run_quality_contract.py",
    "agent_execution_monitor_schema": "engineering-assistant/schemas/agent-execution-monitor.schema.json",
    "post_task_plan_alignment_required": true,
    "post_task_plan_alignment_schema": "engineering-assistant/schemas/post-task-plan-alignment.schema.json",
    "policy_source": "workflow-orchestrator.workflow_runtime_policy.lean_runtime_router_policy",
    "full_policy_required_for": false
  },
  "engineering_governance_state_machine": {
    "model_name": "engineering-governance-v2",
    "positioning": "engineering-assistant 保留软件工程方法论主控权；Codex、Hermes、skills 和 MCP 是可委派执行能力，不替代工程状态、边界、门禁和验收责任。",
    "default_stage_model": [
      "intake",
      "context_modeling",
      "architecture_boundary",
      "implementation_contract",
      "controlled_execution",
      "quality_verification",
      "review_and_release",
      "retrospective_learning"
    ],
    "stage_contracts": {
      "intake": [
        "requirement_contract",
        "scope_and_non_goals",
        "acceptance_criteria",
        "blocking_questions"
      ],
      "context_modeling": [
        "repo_context",
        "module_map",
        "reusable_capabilities",
        "impact_scope"
      ],
      "architecture_boundary": [
        "system_boundary",
        "data_flow",
        "interface_contract",
        "risk_decisions"
      ],
      "implementation_contract": [
        "allowed_modules",
        "forbidden_modules",
        "quality_commands",
        "traceability_matrix"
      ],
      "controlled_execution": [
        "changed_files",
        "delegated_capability_ledger",
        "repair_attempts",
        "control_health"
      ],
      "quality_verification": [
        "test_evidence",
        "build_evidence",
        "browser_or_runtime_evidence",
        "gate_decision"
      ],
      "review_and_release": [
        "findings",
        "approval_requests",
        "release_readiness",
        "rollback_plan"
      ],
      "retrospective_learning": [
        "lessons",
        "rule_candidates",
        "skill_improvement_candidates"
      ]
    },
    "required_control_surface": [
      "current-task.json",
      "current-subtask.json",
      "artifact-index.json",
      "open-questions.json",
      "quality-contract.json",
      "quality-run-report.json",
      "implementation-contract.json",
      "traceability-matrix.json",
      "capability-invocation-ledger.json",
      "control-health-report.json"
    ],
    "hard_rules": [
      "设计阶段可以裁剪，但不得跳过需求边界、影响范围、质量命令和阻断问题判断。",
      "长期任务恢复必须先读取目标项目 artifacts/_control/ 机读控制面，不得用聊天记忆或历史长文档替代。",
      "委派工具完成执行后，engineering-assistant 必须消费其证据并作 gate decision；子工具自述成功不是通过证据。",
      "缺少关键能力时必须按能力协议降级或阻断，不得伪造浏览器、代码图谱、CI、GitHub 或生产状态。"
    ]
  },
  "capability_routing_protocol": {
    "principle": "先用软件工程状态机确定阶段、边界和验收，再选择最合适执行能力；委派不转移工程责任。",
    "decision_values": [
      "use_native_codex",
      "delegate",
      "fallback",
      "block",
      "skip"
    ],
    "capabilities": {
      "codebase_analysis": {
        "preferred": [
          "codegraph"
        ],
        "fallback": [
          "rg",
          "targeted_file_reads",
          "compiler_or_test_feedback"
        ],
        "missing_behavior": "continue_with_lower_confidence",
        "required_evidence": [
          "queried_symbols_or_files",
          "impact_scope",
          "confidence_note"
        ]
      },
      "frontend_product_execution": {
        "preferred": [
          "build-web-apps",
          "browser"
        ],
        "fallback": [
          "repo_native_frontend_stack",
          "playwright_or_local_render_check"
        ],
        "missing_behavior": "block_browser_level_acceptance",
        "required_evidence": [
          "product_ia",
          "state_coverage",
          "desktop_mobile_render_evidence"
        ]
      },
      "github_pr_ci": {
        "preferred": [
          "github"
        ],
        "fallback": [
          "local_git_diff",
          "local_quality_commands"
        ],
        "missing_behavior": "do_not_claim_remote_pr_or_ci_state",
        "required_evidence": [
          "local_diff",
          "commands_run",
          "remote_state_if_available"
        ]
      },
      "security_or_production": {
        "preferred": [
          "security_tools",
          "human_approval"
        ],
        "fallback": [],
        "missing_behavior": "block_until_review",
        "required_evidence": [
          "approval_record",
          "risk_assessment",
          "rollback_or_mitigation"
        ]
      }
    },
    "ledger_artifact": "artifacts/_control/capability-invocation-ledger.json",
    "health_artifact": "artifacts/_control/capability-health.json",
    "block_markers": [
      "CAPABILITY_REQUIRED_BUT_UNAVAILABLE",
      "DELEGATED_OUTPUT_UNVERIFIED",
      "REMOTE_STATE_UNPROVEN"
    ]
  },
  "documentation_output_mode_policy": {
    "default_mode": "control_surface_first",
    "formal_document_mode": "on_human_review_or_audit_need",
    "required_by_default": [
      "machine_readable_contracts",
      "open_questions",
      "quality_commands",
      "traceability",
      "gate_decision",
      "capability_ledger"
    ],
    "optional_by_default": [
      "long_markdown_design",
      "stage_summary",
      "human_readable_html",
      "workflow_summary",
      "handoff_narrative"
    ],
    "promotion_rule": "长文档只有在人类评审、交接、审计、合规或用户明确要求时生成或提升到 docs/；否则保持为 .run-artifacts 或 artifacts/_control 的机读事实。",
    "control_preservation_rule": "减少长文档不能减少控制能力；任何裁剪必须保留当前任务、范围、阻断问题、质量命令、变更追踪和验收证据。"
  },
  "runtime_rule_markers": [
    "ACTIVE_CONTEXT_OVER_BUDGET",
    "ASSISTANT_FEEDBACK_NOT_CONSUMED_BY_AGENT",
    "ASSISTANT_FEEDBACK_NOT_GENERATED",
    "CAPABILITY_HEALTH_NOT_CHECKED",
    "CAPABILITY_REQUIRED_BUT_UNAVAILABLE",
    "COMMENT_GATE_DEFERRED_TO_COMMIT",
    "CONTROL_SURFACE_FIRST_VIOLATED",
    "DELEGATED_OUTPUT_UNVERIFIED",
    "DOC_SPRAWL_RISK",
    "DUPLICATE_CAPABILITY_RISK",
    "ENGINEERING_GOVERNANCE_STATE_NOT_ESTABLISHED",
    "IMPLEMENTATION_STRATEGY_NOT_EVALUATED",
    "MISSING_POST_TASK_ALIGNMENT",
    "NO_EFFECTIVE_CODE_CHANGE",
    "PROCESS_DOCUMENTATION_POLLUTION",
    "PRODUCT_PLAN_DRIFT",
    "REMOTE_STATE_UNPROVEN",
    "TARGET_REPO_ARTIFACT_POLLUTION"
  ],
  "risk": {
    "risk_level": "high",
    "allow_implicit_invocation": false,
    "human_approval_required": [
      "DB/Redis/MQ/权限/发布脚本变更",
      "核心链路实现偏离设计",
      "高风险重构"
    ]
  },
  "quality_gates": [
    "每个变更映射到设计",
    "无无关模块修改",
    "高风险文件已标记",
    "测试命令已列出",
    "需求-设计-代码追踪矩阵已刷新"
  ],
  "workflow": {
    "node_id": "code-development",
    "entry_modes": [
      "auto_flow",
      "from_node",
      "single_node"
    ],
    "next_nodes": []
  },
  "source_files": [
    "skills/code-development/SKILL.md",
    "skills/code-development/contract.yaml",
    "skills/code-development/workflow/node.yaml",
    "skills/code-development/agents/openai.yaml"
  ]
}
