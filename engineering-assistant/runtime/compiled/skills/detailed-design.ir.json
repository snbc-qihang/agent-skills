      "fail_action": "block 或 require_human_review"
    },
    {
      "gate_id": "detailed-design-gate-4",
      "name": "测试策略覆盖主干和异常路径",
      "type": "deterministic",
      "pass_condition": "测试策略覆盖主干和异常路径 有证据证明已满足",
      "fail_action": "block 或 require_human_review"
