{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "health_checks"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "status",
          "confidence",
          "fallback"
        ],
        "properties": {
          "family": {
            "enum": [
              "code_context",
              "frontend_runtime",
              "parallelization",
              "security",
              "self_healing",
              "simplification",
              "vcs_ci_prod"
            ]
          },
          "status": {
            "enum": [
              "available",
              "unavailable",
              "stale",
              "not_checked",
              "blocked"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "fallback": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
