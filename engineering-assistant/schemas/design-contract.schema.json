{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "source_design",
    "source_checksum",
    "goals",
    "acceptance_criteria",
    "module_boundaries",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_design": {
      "type": "string",
      "minLength": 1
    },
    "source_checksum": {
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "module_boundaries": {
      "type": "object",
      "required": [],
      "properties": {
        "allowed_from_design": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_from_design": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string"
        },
        "codegraph_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "document_number": {
      "type": "string"
    },
    "document_status": {
      "type": "string"
    },
    "retention_policy": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "language": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "canonical_path": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "title": "Strict engineering-assistant design contract"
}
