{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/engineering-assistant/change-impact-matrix.schema.json",
  "title": "Change Impact Matrix",
  "type": "object",
  "required": [
    "task_id",
    "changed_points",
    "upstream_callers",
    "downstream_consumers",
    "shared_data",
    "adjacent_business_risks",
    "verification_plan",
    "residual_risks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "changed_points": {
      "type": "array",
      "minItems": 1
    },
    "upstream_callers": {
      "type": "array"
    },
    "downstream_consumers": {
      "type": "array"
    },
    "shared_data": {
      "type": "array"
    },
    "adjacent_business_risks": {
      "type": "array"
    },
    "verification_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "command_or_check",
          "covers"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "command_or_check": {
            "type": "string"
          },
          "covers": {
            "type": "array"
          }
        }
      }
    },
    "residual_risks": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
