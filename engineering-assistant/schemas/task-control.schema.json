{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "title",
    "language",
    "workflow_id",
    "status",
    "control_dir",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "active_stage": {
      "type": "string"
    },
    "status": {
      "enum": [
        "initialized",
        "design_approved",
        "contract_compiled",
        "implementing",
        "quality_running",
        "blocked",
        "succeeded",
        "in_progress",
        "completed"
      ]
    },
    "control_dir": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string"
    },
    "project_profile": {
      "type": "object"
    },
    "current_contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "supersedes_active_task": {
      "type": "string"
    },
    "previous_task": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "active_slice": {
      "type": "object",
      "required": [
        "schema_version",
        "slice_id",
        "parent_task_id",
        "status",
        "control_artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "slice_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "parent_task_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "initialized",
            "contract_compiled",
            "implementing",
            "quality_running",
            "blocked",
            "succeeded"
          ]
        },
        "quality_status": {
          "type": "string"
        },
        "control_artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "browser_evidence": {
          "type": "object"
        },
        "next_required_action": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "Strict engineering-assistant task control contract"
}
