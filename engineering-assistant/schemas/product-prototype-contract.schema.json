{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "prototype_status",
    "screens",
    "user_flows",
    "state_coverage",
    "viewport_evidence",
    "third_party_capability_ledger"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "web_product",
        "app_product",
        "frontend_product",
        "non_frontend_skip"
      ]
    },
    "prototype_status": {
      "enum": [
        "ready_for_review",
        "blocked",
        "skipped_with_reason"
      ]
    },
    "skip_reason": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "user_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "state_coverage": {
      "type": "array",
      "items": {
        "enum": [
          "loading",
          "empty",
          "error",
          "permission",
          "success",
          "validation"
        ]
      }
    },
    "viewport_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "third_party_capability_ledger": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
