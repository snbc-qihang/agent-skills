{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "agents",
    "monitor_checks",
    "consumed_by_orchestrator"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "role",
          "assigned_scope",
          "forbidden_scope",
          "expected_outputs",
          "required_checks",
          "status"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "assigned_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "blocked",
              "skipped"
            ]
          },
          "self_report": {
            "type": "string"
          },
          "observed_evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "independent_verification": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "monitor_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "consumed_by_orchestrator": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
