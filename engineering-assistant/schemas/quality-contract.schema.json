{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "required_commands",
    "required_evidence",
    "quality_gates",
    "repair_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "required_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "repair_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "document_number": {
      "type": "string"
    },
    "document_status": {
      "type": "string"
    },
    "retention_policy": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "language": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "canonical_path": {
      "type": "string"
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "title": "Strict engineering-assistant quality contract"
}
