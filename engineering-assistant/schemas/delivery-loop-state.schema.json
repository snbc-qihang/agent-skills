{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "active_slice",
    "loop_state",
    "evidence_paths",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "active_slice": {
      "type": "string",
      "minLength": 1
    },
    "loop_state": {
      "enum": [
        "goal",
        "prototype",
        "implementation",
        "test",
        "review",
        "next_slice",
        "blocked"
      ]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "document_noise_budget_exceeded": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
