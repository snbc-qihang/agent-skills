{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "default_persistence_mode",
    "effective_persistence_mode",
    "ephemeral_root",
    "target_repo_writes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "default_persistence_mode": {
      "const": "ephemeral"
    },
    "effective_persistence_mode": {
      "enum": [
        "inline",
        "ephemeral",
        "target_repo",
        "blocked"
      ]
    },
    "ephemeral_root": {
      "type": "string",
      "minLength": 1
    },
    "target_repo_writes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pollution_markers": {
      "type": "array",
      "items": {
        "enum": [
          "TARGET_REPO_ARTIFACT_POLLUTION",
          "PROCESS_DOCUMENTATION_POLLUTION"
        ]
      }
    }
  },
  "additionalProperties": true
}
