{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "summary",
    "results",
    "errors",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "status": {
      "enum": [
        "pass",
        "block"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "cwd",
          "required",
          "exit_code",
          "duration_ms",
          "blocking"
        ],
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "title": "Strict engineering-assistant quality run report"
}
