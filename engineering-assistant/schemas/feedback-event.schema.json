{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_id",
    "source_task_id",
    "source_run_id",
    "triggered_skill_id",
    "event_type",
    "severity",
    "symptom",
    "user_correction_summary",
    "evidence_paths",
    "repeat_count",
    "recommended_action",
    "regression_case_candidate",
    "consumed_by_evolution_review"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source_task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "triggered_skill_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "skill_execution_failure",
        "user_correction",
        "review_miss",
        "test_failure",
        "third_party_tool_failure",
        "context_drift",
        "document_noise",
        "prototype_gate_failure",
        "acceptance_failure"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "symptom": {
      "type": "string",
      "minLength": 1
    },
    "user_correction_summary": {
      "type": "string"
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repeat_count": {
      "type": "integer",
      "minimum": 1
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    },
    "regression_case_candidate": {
      "type": "boolean"
    },
    "consumed_by_evolution_review": {
      "type": "boolean"
    },
    "target_project_feedback_root": {
      "const": "artifacts/_control/feedback/"
    },
    "central_feedback_root": {
      "const": "feedback-inbox/"
    }
  },
  "additionalProperties": true
}
