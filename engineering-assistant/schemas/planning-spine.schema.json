{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_goal",
    "capability_map",
    "active_documents",
    "document_budget",
    "roadmap",
    "decision_log"
  ],
  "properties": {
    "product_goal": {
      "type": "string",
      "minLength": 1
    },
    "capability_map": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "active_documents": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object"
      }
    },
    "document_budget": {
      "const": 12
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "superseded_documents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
