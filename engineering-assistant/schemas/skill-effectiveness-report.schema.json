{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "mode",
    "evaluation_state",
    "baselines",
    "evals",
    "pass_rate_delta",
    "token_or_time_cost_delta",
    "quality_findings",
    "doc_noise_score",
    "frontend_product_score",
    "recommendation"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "block",
        "waiting_for_input"
      ]
    },
    "mode": {
      "enum": [
        "spec",
        "grade",
        "report"
      ]
    },
    "evaluation_state": {
      "enum": [
        "spec_ready",
        "waiting_for_results",
        "graded",
        "blocked"
      ]
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pass_rate_delta": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "token_or_time_cost_delta": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "quality_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "summary"
        ]
      }
    },
    "doc_noise_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "frontend_product_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "recommendation": {
      "enum": [
        "keep_and_slim",
        "split_capabilities",
        "delegate_to_curated_tools",
        "retire_skill"
      ]
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
