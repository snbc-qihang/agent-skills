{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "slice_id",
    "parent_task_id",
    "status",
    "control_artifacts",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "3.1.0"
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "enum": [
        "initialized",
        "contract_compiled",
        "implementing",
        "quality_running",
        "blocked",
        "succeeded"
      ]
    },
    "control_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "quality_status": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "browser_evidence": {
      "type": "object"
    },
    "next_required_action": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "title": "Strict engineering-assistant current subtask contract"
}
