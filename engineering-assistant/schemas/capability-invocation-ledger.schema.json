{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "capability_decisions"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "decision",
          "reason"
        ],
        "properties": {
          "family": {
            "enum": [
              "code_context",
              "frontend_runtime",
              "parallelization",
              "security",
              "self_healing",
              "simplification",
              "vcs_ci_prod"
            ]
          },
          "candidate": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "call",
              "skip",
              "unavailable",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "fallback": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "output_consumption": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
