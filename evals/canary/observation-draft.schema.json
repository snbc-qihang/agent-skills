{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "observation", "missing_fields", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["incomplete", "awaiting_attestation"]},
    "observation": {
      "type": "object",
      "required": [
        "simulation", "experiment_kind", "experiment_protocol_digest", "arm_id",
        "task_id", "workload_digest", "variant",
        "product_repository", "git_ref", "treatment_digest", "execution_config_digest",
        "environment_digest", "quality_rubric_digest", "evaluator_id",
        "started_at", "finished_at", "artifact_refs", "trust_provenance"
      ],
      "properties": {
        "simulation": {"const": false},
        "experiment_kind": {"enum": ["paired_canary", "delegation_ablation"]},
        "experiment_protocol_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "arm_id": {"enum": ["baseline", "candidate", "minimum_matrix_inline", "minimum_matrix_risk_delegation", "full_local_control"]},
        "ablation_run_bindings": {"$ref": "#/$defs/ablation_run_bindings"},
        "task_id": {"type": "string", "minLength": 1},
        "workload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "variant": {"enum": ["baseline", "candidate"]},
        "product_repository": {"type": "string", "minLength": 1},
        "git_ref": {"type": "string", "minLength": 1},
        "treatment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "quality_rubric_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluator_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "noncached_input_tokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "wall_time_milliseconds": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "cost_usd_micros": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
        "document_noise_units": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "safety_violations": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "blind_blocker_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "blind_major_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "applicable_matrix_cells": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "closed_matrix_cells": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "production_contract_failures": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "human_intervention_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "human_rework_minutes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "product_gate_failures": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "quality_blocker_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "quality_major_count": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "promotion_attempt_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "promotion_attempt_bindings": {"$ref": "#/$defs/promotion_attempt_bindings"},
        "quality_attempt_binding": {"$ref": "#/$defs/ablation_run_binding"},
        "blind_review_binding": {"$ref": "#/$defs/blind_review_binding"},
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["path", "digest", "measurement_kinds"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "measurement_kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "usage", "timing", "billing", "quality_evaluation",
                    "document_noise", "safety_audit", "experiment_protocol", "run_record",
                    "raw_run_evidence", "inclusion_manifest", "local_audit_report"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "trust_provenance": {
          "type": "object",
          "required": ["evidence_broker_id", "host_trust_config_digest"],
          "properties": {
            "evidence_broker_id": {"type": "string", "minLength": 1},
            "host_trust_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"experiment_kind": {"const": "delegation_ablation"}}},
          "then": {
            "required": [
              "ablation_run_bindings", "promotion_attempt_set_digest",
              "promotion_attempt_bindings", "quality_attempt_binding",
              "blind_review_binding", "human_intervention_count",
              "human_rework_minutes", "product_gate_failures",
              "quality_blocker_count", "quality_major_count"
            ],
            "properties": {"artifact_refs": {"$ref": "#/$defs/formal_artifact_closure"}}
          },
          "else": {"not": {"required": ["ablation_run_bindings"]}}
        }
      ],
      "additionalProperties": false
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "enum": [
          "input_tokens", "noncached_input_tokens", "output_tokens",
          "wall_time_milliseconds", "cost_usd_micros",
          "quality_score", "document_noise_units", "safety_violations",
          "blind_blocker_count", "blind_major_count", "applicable_matrix_cells",
          "closed_matrix_cells", "production_contract_failures",
          "human_intervention_count", "human_rework_minutes",
          "product_gate_failures", "quality_blocker_count", "quality_major_count",
          "formal_attempt_replay"
        ]
      }
    },
    "claims": {
      "type": "object",
      "required": ["canary_observation"],
      "properties": {"canary_observation": {"type": "object"}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "ablation_run_bindings": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"$ref": "#/$defs/ablation_run_binding"}
    },
    "ablation_run_binding": {
      "type": "object",
      "required": ["run_id", "workload_id", "repeat_index", "arm_id", "run_record_digest"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "workload_id": {"type": "string", "minLength": 1},
        "repeat_index": {"type": "integer", "minimum": 1, "maximum": 1024},
        "arm_id": {"enum": ["minimum_matrix_inline", "minimum_matrix_risk_delegation", "full_local_control"]},
        "run_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "promotion_attempt_bindings": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/ablation_run_binding"}
    },
    "blind_review_binding": {
      "type": "object",
      "required": [
        "run_id", "opaque_label", "assignment_raw_digest",
        "assignment_canonical_digest", "score_raw_digest", "score_canonical_digest",
        "reveal_raw_digest", "outcome_fact_digest", "evaluator_session_id",
        "quality_score", "blind_blocker_count", "blind_major_count"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "opaque_label": {"type": "string", "minLength": 1},
        "assignment_raw_digest": {"$ref": "#/$defs/digest"},
        "assignment_canonical_digest": {"$ref": "#/$defs/digest"},
        "score_raw_digest": {"$ref": "#/$defs/digest"},
        "score_canonical_digest": {"$ref": "#/$defs/digest"},
        "reveal_raw_digest": {"$ref": "#/$defs/digest"},
        "outcome_fact_digest": {"$ref": "#/$defs/digest"},
        "evaluator_session_id": {"type": "string", "minLength": 1},
        "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
        "blind_blocker_count": {"type": "integer", "minimum": 0},
        "blind_major_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "formal_artifact_closure": {
      "allOf": [
        {"contains": {"properties": {"measurement_kinds": {"contains": {"const": "experiment_protocol"}}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"measurement_kinds": {"contains": {"const": "run_record"}}}}, "minContains": 3},
        {"contains": {"properties": {"measurement_kinds": {"contains": {"const": "raw_run_evidence"}}}}, "minContains": 1},
        {"contains": {"properties": {"measurement_kinds": {"contains": {"const": "inclusion_manifest"}}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"measurement_kinds": {"contains": {"const": "local_audit_report"}}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "additionalProperties": false
}
