{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "run_id", "protocol_digest", "workload_id",
    "workload_digest", "arm_id", "treatment_digest", "attempt_status",
    "process_exit_code", "gate_outcomes", "usage", "cost", "rework",
    "deliverable_capture",
    "safety", "quality", "quality_blocker_count", "quality_major_count",
    "document_noise", "human_intervention_count", "human_rework_minutes",
    "applicable_matrix_cells", "closed_matrix_cells",
    "production_contract_failures", "raw_receipts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "protocol_digest": {"$ref": "#/$defs/digest"},
    "workload_id": {"type": "string", "minLength": 1},
    "workload_digest": {"$ref": "#/$defs/digest"},
    "arm_id": {"enum": [
      "route_only", "minimum_skills", "full_local",
      "minimum_matrix_inline", "minimum_matrix_risk_delegation", "full_local_control"
    ]},
    "treatment_digest": {"$ref": "#/$defs/digest"},
    "attempt_status": {"enum": ["completed", "failed"]},
    "process_exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "gate_outcomes": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "exit_code", "timed_out"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
          "timed_out": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "status", "input_tokens", "cached_input_tokens", "output_tokens",
        "wall_time_milliseconds"
      ],
      "properties": {
        "status": {"const": "collected"},
        "input_tokens": {"$ref": "#/$defs/count"},
        "cached_input_tokens": {"$ref": "#/$defs/count"},
        "output_tokens": {"$ref": "#/$defs/count"},
        "wall_time_milliseconds": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      },
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_collected", "unavailable", "collected"]},
        "source": {"type": "string", "minLength": 1},
        "cost_usd_micros": {"$ref": "#/$defs/count"}
      },
      "additionalProperties": false
    },
    "deliverable_capture": {"$ref": "#/$defs/deliverable_capture"},
    "rework": {"$ref": "#/$defs/collected_count"},
    "safety": {"$ref": "#/$defs/collected_count"},
    "quality": {"$ref": "#/$defs/collected_count"},
    "quality_blocker_count": {"$ref": "#/$defs/collected_count"},
    "quality_major_count": {"$ref": "#/$defs/collected_count"},
    "document_noise": {"$ref": "#/$defs/collected_count"},
    "human_intervention_count": {"$ref": "#/$defs/collected_count"},
    "human_rework_minutes": {"$ref": "#/$defs/collected_count"},
    "applicable_matrix_cells": {"$ref": "#/$defs/collected_count"},
    "closed_matrix_cells": {"$ref": "#/$defs/collected_count"},
    "production_contract_failures": {"$ref": "#/$defs/collected_count"},
    "blind_review": {"$ref": "#/$defs/blind_review"},
    "raw_receipts": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["receipt_kind", "ref", "digest"],
        "properties": {
          "receipt_kind": {"const": "attempt_fact"},
          "ref": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"cost": {"properties": {"status": {"const": "collected"}}}}},
      "then": {"properties": {"cost": {"required": ["source", "cost_usd_micros"]}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "collected_count": {
      "type": "object",
      "required": ["status", "count"],
      "properties": {
        "status": {"const": "collected"},
        "count": {"$ref": "#/$defs/count"}
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object", "required": ["ref", "digest"],
      "properties": {"ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    },
    "deliverable_capture": {
      "type": "object",
      "required": ["capture_kind", "artifact"],
      "properties": {
        "capture_kind": {
          "enum": ["final_response", "workspace_patch", "workspace_tree"]
        },
        "artifact": {"$ref": "#/$defs/artifact_ref"}
      },
      "additionalProperties": false
    },
    "blind_review": {
      "type": "object", "required": ["assignment_artifact", "score_artifact", "reveal_artifact"],
      "properties": {
        "assignment_artifact": {"$ref": "#/$defs/artifact_ref"},
        "score_artifact": {"$ref": "#/$defs/artifact_ref"},
        "reveal_artifact": {"$ref": "#/$defs/artifact_ref"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
