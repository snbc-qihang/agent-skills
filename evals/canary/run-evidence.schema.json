{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "simulation", "task_id", "workload_digest", "variant", "product_repository", "git_ref", "treatment_digest",
    "execution_config_digest", "environment_digest", "quality_rubric_digest", "evaluator_id",
    "started_at", "finished_at", "input_tokens", "output_tokens",
    "cost_usd_micros", "quality_score", "document_noise_units", "safety_violations",
    "artifact_refs", "trust_provenance", "attestation"
  ],
  "properties": {
    "simulation": {"const": false},
    "task_id": {"type": "string", "minLength": 1},
    "workload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "variant": {"enum": ["baseline", "candidate"]},
    "product_repository": {"type": "string", "minLength": 1},
    "git_ref": {"type": "string", "minLength": 1},
    "treatment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "execution_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "quality_rubric_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd_micros": {"type": "integer", "minimum": 0},
    "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "document_noise_units": {"type": "integer", "minimum": 0},
    "safety_violations": {"type": "integer", "minimum": 0},
    "artifact_refs": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["path", "digest", "measurement_kinds"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "measurement_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "usage", "billing", "quality_evaluation",
                "document_noise", "safety_audit"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "trust_provenance": {
      "type": "object",
      "required": ["evidence_broker_id", "host_trust_config_digest"],
      "properties": {
        "evidence_broker_id": {"type": "string", "minLength": 1},
        "host_trust_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "attestation": {"type": "string", "minLength": 16, "maxLength": 8192}
  },
  "additionalProperties": false
}
