{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "opaque_label", "asset_artifact",
    "rubric_artifact", "assignment_session_id", "assigned_at",
    "assignment_transcript_artifact"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "opaque_label": {"type": "string", "pattern": "^opaque-[0-9a-f]{16,64}$"},
    "asset_artifact": {"$ref": "#/$defs/artifact_ref"},
    "rubric_artifact": {"$ref": "#/$defs/artifact_ref"},
    "assignment_session_id": {"type": "string", "minLength": 1},
    "assigned_at": {"type": "string", "format": "date-time"},
    "assignment_transcript_artifact": {"$ref": "#/$defs/artifact_ref"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object", "required": ["ref", "digest"],
      "properties": {"ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
