{
  "version": "1.0.0.0-rc.1",
  "skills": [
    {
      "id": "engineering-assistant",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "both",
      "description": "将工程任务路由到最小充分的 skill 或受治理 flow。适用于请求跨越上下文、设计、实现、评审、发布或长期任务协调的场景。",
      "leading_words": ["最小充分", "路由决策"],
      "capabilities": ["route-engineering"],
      "inputs": ["user-request", "project-profile", "capability-health"],
      "completion_criteria": [
        {"id": "route-explained", "description": "已说明所选 flow 或原语及其风险和授权边界。", "evidence_kinds": ["source", "approval"]},
        {"id": "minimum-context", "description": "只加载所选 skill 及其直接引用的 policy。", "evidence_kinds": ["source"]}
      ],
      "context_pointers": [
        {"when": "任务跨越多个 flow 或无法在单次会话内完成", "path": "references/wayfinding.md", "purpose": "在不预先规划未知工作的前提下选择长期任务路径。"},
        {"when": "路由包含写入、发布或外部动作", "path": "references/authorization.md", "purpose": "加载授权和审批规则。"}
      ],
      "policy_refs": ["safety-core", "risk-approval", "evidence-quality"],
      "risk_class": "read_only",
      "source_path": "skills/engineering-assistant"
    },
    {
      "id": "research",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "基于一手资料研究工程问题，并输出有引用、有边界的结论。适用于外部项目、API、标准或不熟悉的技术事实。",
      "leading_words": ["一手资料", "来源追踪"],
      "capabilities": ["research"],
      "inputs": ["research-question", "source-boundary"],
      "completion_criteria": [
        {"id": "claims-cited", "description": "每项重要结论都有一手资料支撑，或已明确标记为推断。", "evidence_kinds": ["source"]},
        {"id": "scope-bounded", "description": "研究已回答既定问题，并记录尚未解决的不确定性。", "evidence_kinds": ["source"]}
      ],
      "context_pointers": [
        {"when": "研究对象是 GitHub 仓库", "path": "references/github-research.md", "purpose": "检查源码、生命周期、测试和仓库规则。"}
      ],
      "policy_refs": ["evidence-quality", "document-governance"],
      "risk_class": "read_only",
      "source_path": "skills/research"
    },
    {
      "id": "decision-interview",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "在查明仓库事实后，与用户一起解决相互依赖的产品或设计决策。适用于范围、取舍或验收标准仍不明确的场景。",
      "leading_words": ["决策树", "事实优先"],
      "capabilities": ["decision-interview"],
      "inputs": ["open-decisions", "discovered-facts"],
      "completion_criteria": [
        {"id": "facts-discovered", "description": "在询问用户前，已先调查可从现有资料回答的问题。", "evidence_kinds": ["source"]},
        {"id": "decisions-owned", "description": "重大取舍已有明确的人工决定，或仍保持阻断。", "evidence_kinds": ["approval"]}
      ],
      "context_pointers": [
        {"when": "缺失事实彼此独立", "path": "references/batch-facts.md", "purpose": "一次性分组收集相互独立的事实输入。"}
      ],
      "policy_refs": ["risk-approval", "evidence-quality"],
      "risk_class": "read_only",
      "source_path": "skills/decision-interview"
    },
    {
      "id": "domain-modeling",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "构建或澄清领域术语、关系和难以逆转的决策。适用于产品语言模糊、含义过载或与代码不一致的场景。",
      "leading_words": ["统一语言", "业务场景"],
      "capabilities": ["domain-modeling"],
      "inputs": ["domain-statements", "repository-context", "existing-glossary"],
      "completion_criteria": [
        {"id": "terms-resolved", "description": "每个变更术语都有唯一规范含义，并已记录冲突用法。", "evidence_kinds": ["source", "review"]},
        {"id": "adr-sparse", "description": "只为难以逆转、反直觉且真实存在的取舍创建 ADR。", "evidence_kinds": ["review"]}
      ],
      "context_pointers": [
        {"when": "某项决策确实需要 ADR", "path": "references/adr-format.md", "purpose": "记录决策与备选方案，同时避免把术语表写成规格说明。"}
      ],
      "policy_refs": ["document-governance", "evidence-quality"],
      "risk_class": "reversible_write",
      "source_path": "skills/domain-modeling"
    },
    {
      "id": "repo-context",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "基于源码证据梳理仓库模块、接口、数据、依赖、可复用能力和影响范围。适用于设计或大范围变更分析之前。",
      "leading_words": ["影响范围", "源码追踪"],
      "capabilities": ["repo-context"],
      "inputs": ["repository", "task-boundary"],
      "completion_criteria": [
        {"id": "scope-complete", "description": "范围内每个模块和外部边界都有证据，或已明确标记为未知。", "evidence_kinds": ["source"]},
        {"id": "reuse-identified", "description": "已明确列出现有可复用能力和禁止改动边界。", "evidence_kinds": ["source"]}
      ],
      "context_pointers": [
        {"when": "检测到数据库、Redis、MQ 或前端变更", "path": "references/specialist-context.md", "purpose": "只加载相关专业领域的证据检查项。"}
      ],
      "policy_refs": ["evidence-quality", "scope-control"],
      "risk_class": "read_only",
      "source_path": "skills/repo-context"
    },
    {
      "id": "wayfinder",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "both",
      "description": "把大型或高不确定性工程任务整理为目标、当前前沿和待决策事项。适用于工作超过一次会话或尚不能安全切片的场景。",
      "leading_words": ["目标", "当前前沿", "认知迷雾"],
      "capabilities": ["wayfinder"],
      "inputs": ["destination", "known-decisions", "current-frontier"],
      "completion_criteria": [
        {"id": "destination-bounded", "description": "目标和范围外边界已经明确。", "evidence_kinds": ["review"]},
        {"id": "frontier-actionable", "description": "每个前沿事项都足够明确，可以继续调查或决策，而无需臆造未知工作。", "evidence_kinds": ["source", "review"]}
      ],
      "context_pointers": [
        {"when": "前沿事项需要人工判断", "path": "references/hitl.md", "purpose": "区分人工决策与 agent 可独立执行的调查任务。"}
      ],
      "policy_refs": ["scope-control", "document-governance", "risk-approval"],
      "risk_class": "reversible_write",
      "source_path": "skills/wayfinder"
    },
    {
      "id": "prototype",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "构建明确可丢弃的逻辑或界面原型，用于回答一个设计问题。适用于具体交互验证比继续抽象讨论成本更低的场景。",
      "leading_words": ["可丢弃", "只回答一个问题"],
      "capabilities": ["prototype"],
      "inputs": ["design-question", "project-conventions"],
      "completion_criteria": [
        {"id": "question-answered", "description": "原型已为既定设计问题产生可观察证据。", "evidence_kinds": ["browser", "test", "review"]},
        {"id": "disposition-known", "description": "决策完成后，原型已明确标记为删除或正式吸收。", "evidence_kinds": ["review"]}
      ],
      "context_pointers": [
        {"when": "问题与界面有关", "path": "references/ui.md", "purpose": "在真实应用外壳中构建可比较的方案。"},
        {"when": "问题与状态或逻辑有关", "path": "references/logic.md", "purpose": "构建可运行的小型状态探索器。"}
      ],
      "policy_refs": ["scope-control", "frontend-product", "evidence-quality"],
      "risk_class": "reversible_write",
      "source_path": "skills/prototype"
    },
    {
      "id": "codebase-design",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "设计小接口、高杠杆、变更局部化的深模块和清晰 seam。适用于架构边界、可测试性或重构结构设计。",
      "leading_words": ["深模块", "seam", "局部性"],
      "capabilities": ["codebase-design"],
      "inputs": ["repo-context", "change-goal"],
      "completion_criteria": [
        {"id": "interface-small", "description": "所提接口只暴露调用方必须知道的内容。", "evidence_kinds": ["source", "review"]},
        {"id": "seam-real", "description": "每个新增 seam 都有真实变化原因，而非假设性扩展。", "evidence_kinds": ["source", "test"]}
      ],
      "context_pointers": [
        {"when": "存在多个可行接口方案", "path": "references/design-it-twice.md", "purpose": "在选择前比较实质不同的接口设计。"}
      ],
      "policy_refs": ["scope-control", "evidence-quality", "team-standards"],
      "risk_class": "read_only",
      "source_path": "skills/codebase-design"
    },
    {
      "id": "tdd",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "在确认的公共 seam 上使用红绿循环纵向切片实现一个行为。适用于测试优先的功能、修复和回归覆盖。",
      "leading_words": ["seam", "红绿循环", "tracer bullet"],
      "capabilities": ["tdd"],
      "inputs": ["accepted-behavior", "confirmed-seam", "quality-command"],
      "completion_criteria": [
        {"id": "red-observed", "description": "实现前，测试已因预期缺失或损坏行为而失败。", "evidence_kinds": ["test"]},
        {"id": "green-observed", "description": "最小实现后，同一测试和相关回归套件均已通过。", "evidence_kinds": ["test"]}
      ],
      "context_pointers": [
        {"when": "需要替换依赖边界", "path": "references/mocking.md", "purpose": "只在真实 seam 上使用 fake 或 mock。"}
      ],
      "policy_refs": ["scope-control", "evidence-quality", "team-standards"],
      "risk_class": "reversible_write",
      "source_path": "skills/tdd"
    },
    {
      "id": "diagnosing-bugs",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "通过复现、最小化、可证伪假设、定向观测、修复和回归证据诊断疑难缺陷或性能退化。",
      "leading_words": ["紧反馈环", "可复现失败", "可证伪"],
      "capabilities": ["diagnosing-bugs"],
      "inputs": ["reported-symptom", "runtime-access", "repository"],
      "completion_criteria": [
        {"id": "loop-red-capable", "description": "一个快速命令可以复现或检测用户报告的准确症状。", "evidence_kinds": ["test", "source", "external_state"]},
        {"id": "cause-falsified", "description": "证据能够区分已接受根因与其他竞争假设。", "evidence_kinds": ["test", "source"]},
        {"id": "regression-closed", "description": "清理诊断代码后，原始反馈环和回归证据均已通过。", "evidence_kinds": ["test"]}
      ],
      "context_pointers": [
        {"when": "症状具有非确定性", "path": "references/flaky-bugs.md", "purpose": "诊断前先提高并测量复现率。"},
        {"when": "症状属于性能问题", "path": "references/performance.md", "purpose": "优先测量和分析，而不是添加大范围日志。"}
      ],
      "policy_refs": ["evidence-quality", "scope-control", "risk-approval"],
      "risk_class": "reversible_write",
      "source_path": "skills/diagnosing-bugs"
    },
    {
      "id": "code-review",
      "version": "1.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "针对固定 diff、阶段状态或自动门禁，分别依据仓库规范和原始需求进行评审。适用于分支、Pull Request、阶段审计、blocker 判断或开发中的变更。",
      "leading_words": ["固定比较点", "阶段审计", "自动门禁", "规范轴", "需求轴"],
      "capabilities": ["code-review"],
      "inputs": ["fixed-point", "diff", "standards", "specification"],
      "completion_criteria": [
        {"id": "axes-independent", "description": "规范问题和需求问题先独立评估，再合并结论。", "evidence_kinds": ["source", "review"]},
        {"id": "findings-actionable", "description": "每项问题都包含证据、影响和级别，且不重复确定性工具输出。", "evidence_kinds": ["source", "test", "ci", "review"]}
      ],
      "context_pointers": [
        {"when": "仓库规范缺失或不完整", "path": "references/smell-baseline.md", "purpose": "使用明确标记的启发式基线，但不把主观判断当作硬性违规。"}
      ],
      "policy_refs": ["evidence-quality", "team-standards", "risk-approval"],
      "risk_class": "read_only",
      "source_path": "skills/code-review"
    }
  ]
}
