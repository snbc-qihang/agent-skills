{
  "version": "3.0.0.0-rc.1",
  "skills": [
    {
      "id": "engineering-assistant",
      "version": "3.0.0.0-rc.1",
      "invocation_mode": "both",
      "description": "将工程任务路由到最小充分的 skill 或受治理 flow。适用于请求跨越上下文、设计、实现、评审、发布或长期任务协调的场景。",
      "leading_words": [
        "最小充分",
        "路由决策"
      ],
      "capabilities": [
        "route-engineering"
      ],
      "inputs": [
        "user-request",
        "project-profile",
        "capability-health",
        "design-source-ref"
      ],
      "completion_criteria": [
        {
          "id": "route-explained",
          "description": "已说明所选 flow 或原语及其风险和授权边界。",
          "evidence_kinds": [
            "source",
            "approval"
          ]
        },
        {
          "id": "minimum-context",
          "description": "只加载所选 skill 及其直接引用的 policy。",
          "evidence_kinds": [
            "source"
          ]
        }
      ],
      "context_pointers": [
        {
          "when": "任务跨越多个 flow 或无法在单次会话内完成",
          "path": "references/wayfinding.md",
          "purpose": "在不预先规划未知工作的前提下选择长期任务路径。"
        },
        {
          "when": "路由包含写入、发布或外部动作",
          "path": "references/authorization.md",
          "purpose": "加载授权和审批规则。"
        }
      ],
      "policy_refs": [
        "safety-core",
        "risk-approval",
        "evidence-quality"
      ],
      "risk_class": "read_only",
      "source_path": "skills/engineering-assistant"
    },
    {
      "id": "research",
      "version": "3.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "基于一手资料研究工程问题，并输出有引用、有边界的结论。适用于外部项目、API、标准或不熟悉的技术事实。",
      "leading_words": [
        "一手资料",
        "来源追踪"
      ],
      "capabilities": [
        "research"
      ],
      "inputs": [
        "research-question",
        "source-boundary"
      ],
      "completion_criteria": [
        {
          "id": "claims-cited",
          "description": "每项重要结论都有一手资料支撑，或已明确标记为推断。",
          "evidence_kinds": [
            "source"
          ]
        },
        {
          "id": "scope-bounded",
          "description": "研究已回答既定问题，并记录尚未解决的不确定性。",
          "evidence_kinds": [
            "source"
          ]
        }
      ],
      "context_pointers": [
        {
          "when": "研究对象是 GitHub 仓库",
          "path": "references/github-research.md",
          "purpose": "检查源码、生命周期、测试和仓库规则。"
        }
      ],
      "policy_refs": [
        "evidence-quality",
        "document-governance"
      ],
      "risk_class": "read_only",
      "source_path": "skills/research"
    },
    {
      "id": "decision-interview",
      "version": "3.0.0.0-rc.1",
      "invocation_mode": "model",
      "description": "在查明仓库事实后，与用户一起解决相互依赖的产品或设计决策。适用于范围、取舍或验收标准仍不明确的场景。",
      "leading_words": [
