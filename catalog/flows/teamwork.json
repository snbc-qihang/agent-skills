{
  "version": "2.0.0.0-rc.1",
  "flows": [
    {
      "id": "team-delivery",
      "version": "2.0.0.0-rc.1",
      "entry_conditions": ["rrq-yq-team profile 已启用", "任务需要团队级需求、设计、实现、发布或复盘闭环"],
      "nodes": [
        {"id": "requirements-facts", "capability": "repo-context", "depends_on": [], "when": "always", "completion_criteria": ["需求事实、仓库事实、外部约束和未知项已分离"], "policy_refs": ["evidence-quality", "teamwork-rule-consumption"], "evidence_kinds": ["source"], "evidence_scope_tags": ["flow:team-delivery", "stage:requirements"]},
        {"id": "decision-convergence", "capability": "decision-interview", "depends_on": ["requirements-facts"], "when": "存在影响范围、规则或验收决策", "completion_criteria": ["重大决策已有答案或明确阻断"], "policy_refs": ["risk-approval", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:requirements"]},
        {"id": "requirements-contract", "capability": "shape-contract", "depends_on": ["decision-convergence"], "when": "always", "completion_criteria": ["目标、范围、非目标、验收、依赖和风险已形成需求契约"], "policy_refs": ["scope-control", "document-governance", "teamwork-delivery-gates", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:requirements"]},
        {"id": "architecture-design", "capability": "architecture-design", "depends_on": ["requirements-contract"], "when": "always", "completion_criteria": ["系统边界、协作、失败模式和一致性风险已明确"], "policy_refs": ["team-standards", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:design"]},
        {"id": "frontend-design", "capability": "frontend-design", "depends_on": ["architecture-design"], "when": "影响范围命中前端，否则 Runtime 必须显式跳过", "completion_criteria": ["前端交互、状态、验收和实现约束已明确"], "policy_refs": ["frontend-product", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "specialty:frontend"]},
        {"id": "database-design", "capability": "database-design", "depends_on": ["architecture-design"], "when": "影响范围命中数据库，否则 Runtime 必须显式跳过", "completion_criteria": ["schema、索引、事务、迁移和回滚已明确"], "policy_refs": ["risk-approval", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "specialty:database"]},
        {"id": "redis-design", "capability": "redis-design", "depends_on": ["architecture-design"], "when": "影响范围命中 Redis，否则 Runtime 必须显式跳过", "completion_criteria": ["key、TTL、一致性、容量和运维约束已明确"], "policy_refs": ["risk-approval", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "specialty:redis"]},
        {"id": "mq-design", "capability": "mq-design", "depends_on": ["architecture-design"], "when": "影响范围命中 MQ，否则 Runtime 必须显式跳过", "completion_criteria": ["消息契约、幂等、重试、死信和回放已明确"], "policy_refs": ["risk-approval", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "specialty:mq"]},
        {"id": "implementation-contract", "capability": "implementation-contract", "depends_on": ["frontend-design", "database-design", "redis-design", "mq-design"], "when": "always", "completion_criteria": ["接口、状态、行为、测试、任务和回滚形成实现契约"], "policy_refs": ["evidence-quality", "document-governance", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:design"]},
        {"id": "design-approval", "capability": "design-review", "depends_on": ["implementation-contract"], "when": "设计准备进入实现", "completion_criteria": ["设计评审阻断项关闭且受信人工设计审批已绑定"], "policy_refs": ["risk-approval", "teamwork-delivery-gates", "teamwork-rule-consumption"], "evidence_kinds": ["review", "approval"], "evidence_scope_tags": ["flow:team-delivery", "gate:design-approval"], "required_evidence_kinds": ["review", "approval"]},
        {"id": "work-slicing", "capability": "work-slicing", "depends_on": ["design-approval"], "when": "always", "completion_criteria": ["已选择边界清晰且可观察的纵向切片"], "policy_refs": ["scope-control", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:implementation"]},
        {"id": "tdd", "capability": "tdd", "depends_on": ["work-slicing"], "when": "存在稳定公共 seam", "completion_criteria": ["同一行为具备可复现红灯和绿灯证据"], "policy_refs": ["evidence-quality", "teamwork-rule-consumption"], "evidence_kinds": ["test"], "evidence_scope_tags": ["flow:team-delivery", "stage:implementation"]},
        {"id": "implementation", "capability": "implementation", "depends_on": ["work-slicing"], "when": "always", "completion_criteria": ["实现保持在批准范围并映射验收标准"], "policy_refs": ["scope-control", "risk-approval", "teamwork-rule-consumption"], "evidence_kinds": ["source", "test"], "evidence_scope_tags": ["flow:team-delivery", "stage:implementation"]},
        {"id": "quality-gate", "capability": "quality-evidence", "depends_on": ["tdd", "implementation"], "when": "always", "completion_criteria": ["六维质量门禁均有实际观察且通过"], "policy_refs": ["evidence-quality", "teamwork-delivery-gates", "teamwork-rule-consumption"], "evidence_kinds": ["test", "build", "ci", "review"], "evidence_scope_tags": ["flow:team-delivery", "gate:quality"], "required_evidence_kinds": ["test", "build", "ci", "review"]},
        {"id": "code-confirmation", "capability": "code-review", "depends_on": ["quality-gate"], "when": "always", "completion_criteria": ["代码评审无阻断项且受信人工代码确认已绑定"], "policy_refs": ["risk-approval", "teamwork-delivery-gates", "teamwork-rule-consumption"], "evidence_kinds": ["review", "approval"], "evidence_scope_tags": ["flow:team-delivery", "gate:code-confirmation"], "required_evidence_kinds": ["review", "approval"]},
        {"id": "release-readiness", "capability": "release-readiness", "depends_on": ["code-confirmation"], "when": "任务需要真实发布", "completion_criteria": ["范围、风险、窗口、负责人、回滚和受信发布审批完备"], "policy_refs": ["release-safety", "teamwork-delivery-gates"], "evidence_kinds": ["source", "review", "ci", "approval"], "evidence_scope_tags": ["flow:team-delivery", "gate:release-approval"], "required_evidence_kinds": ["source", "review", "ci", "approval"]},
        {"id": "release-verification", "capability": "release-verification", "depends_on": ["release-readiness"], "when": "外部受信系统已执行发布", "completion_criteria": ["Broker 验签的外部状态证据支持发布或回滚状态"], "policy_refs": ["release-safety", "evidence-quality", "teamwork-delivery-gates"], "evidence_kinds": ["ci", "external_state"], "evidence_scope_tags": ["flow:team-delivery", "stage:release"], "required_evidence_kinds": ["ci", "external_state"]},
        {"id": "release-retrospective", "capability": "release-retrospective", "depends_on": ["release-verification"], "when": "发布或回滚已完成", "completion_criteria": ["结果、问题、原因和后续事项已复盘"], "policy_refs": ["feedback-evolution", "document-governance", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:retrospective"]},
        {"id": "feedback-refinement", "capability": "feedback-ingest", "depends_on": ["release-retrospective"], "when": "复盘包含可复用反馈", "completion_criteria": ["反馈具备来源、症状、范围和复发数据"], "policy_refs": ["feedback-evolution", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:evolution"]},
        {"id": "rule-candidate-quality", "capability": "skill-quality", "depends_on": ["feedback-refinement"], "when": "存在规范候选；不存在时 Runtime 必须显式跳过并正常完成", "completion_criteria": ["候选通过可预测性、相关性、重复、上下文和安全审计"], "policy_refs": ["feedback-evolution", "teamwork-rule-consumption"], "evidence_kinds": ["source", "review"], "evidence_scope_tags": ["flow:team-delivery", "stage:evolution"]},
        {"id": "tl-disposition", "capability": "skill-evolution", "depends_on": ["rule-candidate-quality"], "when": "规范候选通过质量审计；不存在候选时 Runtime 必须显式跳过", "completion_criteria": ["TL 已拒绝候选，或批准创建独立规则变更任务"], "policy_refs": ["feedback-evolution", "teamwork-delivery-gates", "teamwork-rule-consumption"], "evidence_kinds": ["review", "approval"], "evidence_scope_tags": ["flow:team-delivery", "gate:tl-disposition"], "required_evidence_kinds": ["review", "approval"]}
      ],
      "terminal_conditions": ["无规范候选时复盘正常完成", "存在规范候选时 TL 已拒绝或批准创建独立规则变更任务", "任一可信审批或外部证据缺失时保持等待"],
      "policy_refs": ["safety-core", "risk-approval", "evidence-quality", "document-governance", "release-safety", "feedback-evolution", "teamwork-delivery-gates", "teamwork-rule-consumption"]
    }
  ]
}
