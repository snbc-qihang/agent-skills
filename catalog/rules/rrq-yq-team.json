  "rules": [
    {
      "id": "A1",
      "category": "架构",
      "guidance": "不强制平台采用微服务 + 事件驱动 + DDD，但是设计文档必须体现系统边界、业务域、事件协作和最终一致性。",
      "source_refs": [
        "rrq-architecture"
      ],
      "target_refs": [
        "rrq-yq-architecture"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "design-review",
        "code-review"
      ]
    },
    {
      "id": "A2",
      "category": "架构",
      "guidance": "系统间交互优先通过开放能力接口或事件，不允许直接调用未开放接口。",
      "source_refs": [
        "rrq-architecture"
      ],
      "target_refs": [
        "rrq-yq-architecture"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "design-review",
        "code-review"
      ]
    },
    {
      "id": "A3",
      "category": "架构",
      "guidance": "目标业务系统与目标客户端系统属于不同系统边界，跨系统协作必须明确接口、事件、消息体、幂等和一致性。",
      "source_refs": [
        "rrq-architecture"
      ],
      "target_refs": [
        "rrq-yq-architecture"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "design-review",
        "code-review"
      ]
    },
    {
      "id": "A4",
      "category": "架构",
      "guidance": "应用层只暴露 api/tapi/mapi/console，业务层和共享层只暴露 service 能力。",
      "source_refs": [
        "rrq-architecture"
      ],
      "target_refs": [
        "rrq-yq-architecture"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "design-review",
        "code-review"
      ]
    },
    {
      "id": "A5",
      "category": "架构",
      "guidance": "关键跨系统场景必须进入关键场景设计；简单服务内部 CRUD 不进入关键场景文档。",
      "source_refs": [
        "rrq-architecture"
      ],
      "target_refs": [
        "rrq-yq-architecture"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "design-review",
        "code-review"
      ]
    },
    {
      "id": "A6",
      "category": "架构",
      "guidance": "跨库事务优先本地消息表、事件驱动、补偿机制；必要时使用 Seata，并说明事务边界。",
      "source_refs": [
        "rrq-architecture"
      ],
      "target_refs": [
        "rrq-yq-architecture"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "design-review",
        "code-review"
      ]
    },
    {
      "id": "H1",
      "category": "概要设计",
      "guidance": "概要设计评审稿必须以任务固定的外部 HLD 基线和对应模板为确定性输入，生成结构完整、可直接评审的 reviewing 文档；只有服务边界、数据主权、依赖方向或其他系统级架构变化才允许生成。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "design-source-read",
        "architecture-design",
        "review-package-validation",
        "design-review"
      ]
    },
    {
      "id": "H2",
      "category": "概要设计",
      "guidance": "明确参与系统、职责边界、调用方向、事件流和异常流。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H3",
      "category": "概要设计",
      "guidance": "声明是否涉及 Redis/MQ/DB/定时任务/权限/幂等/跨系统交互。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H4",
      "category": "概要设计",
      "guidance": "后端业务系统研发结构按 presentation/application/domain/port/infrastructure/common 分层；如项目 profile 另有约定，以 profile 为准。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H5",
      "category": "概要设计",
      "guidance": "application 层负责编排，不直接沉淀复杂业务判断；核心业务规则进入 domain。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H6",
      "category": "概要设计",
      "guidance": "聚合根不通过依赖注入创建，应通过工厂创建；一次业务中聚合根创建和修改边界要清晰。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H7",
      "category": "概要设计",
      "guidance": "概要设计评审稿必须严格遵守外部事实源中的 HLD 模板并保留完整正文，不得以增量建议、通用 Findings 或门禁摘要替代；元数据必须声明 reviewing、base_document_number、base_version、base_digest 和 requirement_id。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "design-source-read",
        "architecture-design",
        "review-package-validation",
        "design-review"
      ]
    },
    {
      "id": "H8",
      "category": "概要设计",
      "guidance": "系统级变更涉及跨服务协作时，概要设计评审稿按外部模板表达服务间时序、异常流和一致性；图表类型、格式和参与者层级以固定模板与维护规范为准。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H9",
      "category": "概要设计",
      "guidance": "概要设计与本次需求的关联只进入元数据、修订记录和独立追踪矩阵；不得把 requirement_id、验收条目或一次性方案写入 HLD 长期架构正文。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H10",
      "category": "概要设计",
      "guidance": "概要设计聚焦跨系统/跨服务架构边界、服务间时序、调用/事件方向、异常流、最终一致性和专项文档引用；不得展开接口字段、请求/响应字段、SQL/DDL、数据库字段索引、Controller/Mapper/Repository、类方法签名、伪代码或单元测试步骤。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "H11",
      "category": "概要设计",
      "guidance": "概要设计只表达长期系统级架构；接口字段、DB/MQ/Redis/IAM 资源级细节和当前需求实现步骤进入上下文详细设计、专项设计或专项差异，不得塞入 HLD。",
      "source_refs": [
        "rrq-architecture",
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "architecture-design",
        "design-review"
      ]
    },
    {
      "id": "D1",
      "category": "详细设计",
      "guidance": "每个受影响上下文必须基于固定的外部上下文详细设计和对应模板，生成结构完整、可直接评审的 reviewing 文档；不得只输出本次变更的零散建议。",
      "source_refs": [
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "design-source-read",
        "implementation-contract",
        "review-package-validation",
        "design-review",
        "work-slicing",
        "implementation"
      ]
    },
    {
      "id": "D2",
      "category": "详细设计",
      "guidance": "列出业务规则、状态机、校验规则、异常码、幂等点、事务边界、回滚策略。",
      "source_refs": [
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "implementation-contract",
        "design-review",
        "work-slicing",
        "implementation"
      ]
    },
    {
      "id": "D3",
      "category": "详细设计",
      "guidance": "导入、批处理、异步任务必须写数据量上限、批次大小、超时时间、进度查询、失败处理。",
      "source_refs": [
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "implementation-contract",
        "design-review",
        "work-slicing",
        "implementation"
      ]
    },
    {
      "id": "D4",
      "category": "详细设计",
      "guidance": "状态流转说明允许状态、终态、CAS/乐观锁控制、并发竞争处理。",
      "source_refs": [
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "implementation-contract",
        "design-review",
        "work-slicing",
        "implementation"
      ]
    },
    {
      "id": "D5",
      "category": "详细设计",
      "guidance": "项目定制功能不能破坏原有通用能力，说明新增模块边界和兼容策略。",
      "source_refs": [
        "yq-overview"
      ],
      "target_refs": [
        "rrq-yq-delivery"
      ],
      "capability_refs": [
        "implementation-contract",
        "design-review",
        "work-slicing",
        "implementation"
      ]
    },
    {
      "id": "I2",
      "category": "接口",
      "guidance": "接口必须有充分业务理由，禁止 API 简单封装 DB CRUD。",
      "source_refs": [
        "rrq-yapi-standard"
      ],
      "target_refs": [
        "rrq-yq-api"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "code-review"
      ]
    },
    {
      "id": "I5",
      "category": "接口",
      "guidance": "响应结构为 header.code/header.message/body。",
      "source_refs": [
        "rrq-yapi-standard"
      ],
      "target_refs": [
        "rrq-yq-api"
      ],
      "capability_refs": [
        "architecture-design",
        "implementation-contract",
        "code-review"
      ]
    },
    {
      "id": "E5",
      "category": "异常",
      "guidance": "禁止空 catch、只打印不抛、重复打印日志、用异常控制业务流程。",
      "source_refs": [
        "rrq-common-tech"
      ],
      "target_refs": [
        "rrq-yq-api"
      ],
      "capability_refs": [
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "E7",
      "category": "异常",
      "guidance": "异常日志必须包含 TraceId，敏感信息不得进入异常消息或日志。",
      "source_refs": [
        "rrq-common-tech"
      ],
      "target_refs": [
        "rrq-yq-api"
      ],
      "capability_refs": [
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "P1",
      "category": "幂等并发",
      "guidance": "修改核心数据接口必须评估幂等。",
      "source_refs": [
        "rrq-idempotency"
      ],
      "target_refs": [
        "rrq-yq-code-quality"
      ],
      "capability_refs": [
        "implementation-contract",
        "implementation",
        "quality-evidence",
        "code-review"
      ]
    },
    {
      "id": "P4",
      "category": "幂等并发",
      "guidance": "最终一致性只处理最新消息，旧消息基于时间戳/版本号丢弃。",
      "source_refs": [
        "rrq-idempotency"
      ],
      "target_refs": [
        "rrq-yq-code-quality"
      ],
      "capability_refs": [
        "implementation-contract",
        "implementation",
        "quality-evidence",
        "code-review"
      ]
    },
    {
      "id": "R1",
      "category": "Redis",
      "guidance": "Redis 只做加速层、协调层、短态承载层，不做事实库、分析库、跨服务共享源、消息队列。",
      "source_refs": [
        "rrq-redis-standard",
        "rrq-redis-template"
      ],
      "target_refs": [
        "rrq-yq-redis"
      ],
      "capability_refs": [
        "redis-design",
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "R6",
      "category": "Redis",
      "guidance": "所有 Key 必须设置 TTL，最大不超过 30 天，大批量 Key 增加随机抖动。",
      "source_refs": [
        "rrq-redis-standard",
        "rrq-redis-template"
      ],
      "target_refs": [
        "rrq-yq-redis"
      ],
      "capability_refs": [
        "redis-design",
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "M3",
      "category": "MQ",
      "guidance": "一个服务一个队列，一个队列可绑定多个 Exchange/routingKey。",
      "source_refs": [
        "yq-vems-franchisee"
      ],
      "target_refs": [
        "rrq-yq-mq"
      ],
      "capability_refs": [
        "mq-design",
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "M5",
      "category": "MQ",
      "guidance": "必须配置死信队列，至少记录失败消息。",
      "source_refs": [
        "yq-vems-franchisee"
      ],
      "target_refs": [
        "rrq-yq-mq"
      ],
      "capability_refs": [
        "mq-design",
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "M6",
      "category": "MQ",
      "guidance": "消息体默认不超过 10KB，超过需评审。",
      "source_refs": [
        "yq-vems-franchisee"
      ],
      "target_refs": [
        "rrq-yq-mq"
      ],
      "capability_refs": [
        "mq-design",
        "implementation-contract",
        "implementation",
        "code-review"
      ]
    },
    {
      "id": "DB1",
      "category": "数据库",
      "guidance": "MySQL 是事实数据唯一真相来源，Redis/MQ 不作为事实数据最终来源。",
      "source_refs": [
        "rrq-common-tech"
      ],
      "target_refs": [
        "rrq-yq-database"
      ],
      "capability_refs": [
        "database-design",
        "implementation-contract",
        "design-review"
      ]
    },
    {
      "id": "DB3",
      "category": "数据库",
      "guidance": "禁止无条件全表查询，动态 where 至少有有效条件。",
      "source_refs": [
        "rrq-common-tech"
      ],
      "target_refs": [
        "rrq-yq-database"
      ],
      "capability_refs": [
        "database-design",
        "implementation-contract",
        "design-review"
      ]
    },
    {
      "id": "DB6",
      "category": "数据库",
      "guidance": "数据迁移、DDL、订正需要迁移步骤、灰度、回滚、审批点。",
      "source_refs": [
        "rrq-common-tech"
      ],
      "target_refs": [
        "rrq-yq-database"
      ],
      "capability_refs": [
        "database-design",
        "implementation-contract",
        "design-review"
      ]
