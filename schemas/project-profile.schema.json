{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/project-profile.schema.json",
  "type": "object",
  "required": ["id", "version", "policy_refs", "pack_refs", "rule_catalog_ref", "store", "evidence_broker", "approval_broker", "investigation_policy", "evidence_policy", "adapter_preferences"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pack_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rule_catalog_ref": {"type": ["string", "null"]},
    "store": {
      "type": "object",
      "required": ["run_root", "formal_document_roots"],
      "properties": {
        "run_root": {"const": ".run-artifacts/engineering-assistant"},
        "formal_document_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "evidence_broker": {"$ref": "#/$defs/broker"},
    "approval_broker": {
      "allOf": [
        {"$ref": "#/$defs/broker"},
        {"type": "object", "required": ["audience"], "properties": {"audience": {"type": "string", "minLength": 1}}}
      ]
    },
    "investigation_policy": {"type": "object"},
    "evidence_policy": {"type": "object"},
    "adapter_preferences": {"type": "array", "minItems": 1, "items": {"enum": ["codex", "hermes"]}, "uniqueItems": true}
  },
  "$defs": {
    "broker": {
      "type": "object",
      "required": ["enabled", "id", "introspection_url", "timeout_seconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "id": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "introspection_url": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
