{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/project-profile.schema.json",
  "type": "object",
  "required": ["id", "version", "policy_refs", "pack_refs", "rule_catalog_ref", "store", "local_approval", "investigation_policy", "evidence_policy", "adapter_preferences"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pack_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rule_catalog_ref": {"type": ["string", "null"]},
    "store": {
      "type": "object",
      "required": ["run_root", "formal_document_roots"],
      "properties": {
        "run_root": {"const": ".run-artifacts/teamwork-engineering-assistant"},
        "formal_document_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "local_approval": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    },
    "investigation_policy": {"type": "object"},
    "evidence_policy": {"type": "object"},
    "adapter_preferences": {"type": "array", "minItems": 1, "items": {"enum": ["codex", "hermes"]}, "uniqueItems": true}
  },
  "additionalProperties": false
}
