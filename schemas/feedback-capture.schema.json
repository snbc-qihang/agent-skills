{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/feedback-capture.schema.json",
  "type": "object",
  "required": [
    "capture_id", "session_ref", "turn_ref", "event_name", "platform",
    "model", "permission_mode", "status", "content_digest", "content_length",
    "redaction_count", "candidate_event_ids", "captured_at"
  ],
  "properties": {
    "capture_id": {"type": "string", "pattern": "^capture-[a-f0-9]{24}$"},
    "session_ref": {"type": "string", "pattern": "^session-[a-f0-9]{16}$"},
    "turn_ref": {"type": "string", "pattern": "^turn-[a-f0-9]{16}$"},
    "event_name": {"enum": ["Stop", "UserPromptSubmit"]},
    "platform": {"enum": ["codex", "hermes"]},
    "model": {"type": "string", "minLength": 1},
    "permission_mode": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate_created", "no_signal", "metadata_only", "skipped_continuation"]},
    "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "content_length": {"type": "integer", "minimum": 0},
    "redaction_count": {"type": "integer", "minimum": 0},
    "candidate_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^feedback-[a-f0-9]{24}$"}
    },
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
