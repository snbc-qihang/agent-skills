{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id", "version", "repository_url", "revision", "license",
    "license_evidence", "evidence_digests", "integrity", "decision", "rationale", "evidence_paths",
    "target_refs", "provider_id"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$"},
    "repository_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": "string", "minLength": 1},
    "license_evidence": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"}
    },
    "evidence_digests": {
      "type": "object", "minProperties": 1, "maxProperties": 24,
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "integrity": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision": {"enum": ["fuse", "external_provider", "not_adopted"]},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_paths": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"}
    },
    "target_refs": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "provider_id": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "fuse"}}},
      "then": {
        "properties": {
          "target_refs": {"minItems": 1},
          "integrity": {"type": "null"},
          "provider_id": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "external_provider"}}},
      "then": {
        "properties": {
          "target_refs": {"minItems": 1},
          "integrity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "provider_id": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "not_adopted"}}},
      "then": {
        "properties": {
          "target_refs": {"maxItems": 0},
          "integrity": {"type": "null"},
          "provider_id": {"type": "null"}
        }
      }
    }
  ],
  "additionalProperties": false
}
