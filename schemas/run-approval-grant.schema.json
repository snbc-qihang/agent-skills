{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "grant_id", "broker_id", "audience", "action", "run_id", "run_revision",
    "approval_id", "scope", "issued_at", "expires_at", "actor_ref", "nonce", "token"
  ],
  "properties": {
    "grant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "broker_id": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "action": {"const": "run.approve"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "run_revision": {"type": "integer", "minimum": 0},
    "approval_id": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "actor_ref": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 16},
    "token": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
