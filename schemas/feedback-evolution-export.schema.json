{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/feedback-evolution-export.schema.json",
  "type": "object",
  "required": [
    "schema_version", "proposal_count", "proposals", "next_after_event_ref",
    "snapshot_revision",
    "skipped_invalid_event_count", "skipped_invalid_disposition_count"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "proposals": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/proposal"}
    },
    "next_after_event_ref": {"type": ["string", "null"], "pattern": "^feedback-event-sha256:[0-9a-f]{64}$"},
    "snapshot_revision": {"type": "integer", "minimum": 0},
    "skipped_invalid_event_count": {"type": "integer", "minimum": 0},
    "skipped_invalid_disposition_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "required": [
        "schema_version", "proposal_id", "event_ref", "disposition_id",
        "decision", "event_type", "severity", "recurrence_key_digest", "scope_tags",
        "change_kind", "affected_asset_ref_digests", "recovery_condition",
        "manual_intervention_kind", "evidence_ref_digests", "suggested_regression_scopes",
        "requires_review", "formal_assets_modified", "accepted_at"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "proposal_id": {"type": "string", "pattern": "^feedback-evolution-[0-9a-f]{24}$"},
        "event_ref": {"type": "string", "pattern": "^feedback-event-sha256:[0-9a-f]{64}$"},
        "disposition_id": {"type": "string", "pattern": "^feedback-disposition-[0-9a-f]{24}$"},
        "decision": {"const": "accepted_for_evolution"},
        "event_type": {"enum": ["blocker", "human_correction", "rework", "quality_regression", "tool_failure", "scope_change", "positive_outcome"]},
        "severity": {"enum": ["info", "low", "medium", "high", "blocker"]},
        "recurrence_key_digest": {"type": "string", "pattern": "^recurrence-key-sha256:[0-9a-f]{64}$"},
        "scope_tags": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["quality", "requirements", "task-execution", "tooling", "unknown"]}},
        "change_kind": {"enum": ["correct_behavior", "expand_scope", "repair_failure", "resolve_blocker", "rework_output", "unknown"]},
        "affected_asset_ref_digests": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^asset-ref-sha256:[0-9a-f]{64}$"}},
        "recovery_condition": {"enum": ["apply_corrected_constraint", "recheck_scope_and_acceptance", "repair_and_revalidate", "requires_user_or_external_input", "unknown"]},
        "manual_intervention_kind": {"enum": ["human_approval_or_input", "none", "scope_change", "user_correction"]},
        "evidence_ref_digests": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-ref-sha256:[0-9a-f]{64}$"}},
        "suggested_regression_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["behavior", "capability", "feedback", "hook", "quality", "state_machine"]}},
        "requires_review": {"const": true},
        "formal_assets_modified": {"const": false},
        "accepted_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
