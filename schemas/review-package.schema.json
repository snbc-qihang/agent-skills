{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "impact",
              "specialist-diff",
              "implementation-test-plan",
              "change-summary",
              "checklist",
              "context-design",
              "hld",
              "database-design"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "document_status": {
            "const": "reviewing"
          },
          "base_document_number": {
            "type": "string",
            "minLength": 1
          },
          "base_version": {
            "type": "string",
            "minLength": 1
          },
          "base_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "template": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "document_status"
        ],
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "requirement_item": {
            "type": "string",
            "minLength": 1
          },
          "design_document": {
            "type": "string",
            "minLength": 1
          },
          "design_section": {
            "type": "string",
            "minLength": 1
          },
          "design_change": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "code_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "test_cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "requirement_item",
          "design_document",
          "design_section",
          "design_change",
          "status",
          "code_targets",
          "test_cases"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requirement_id",
    "requirement_items",
    "documents",
    "traceability"
  ],
  "additionalProperties": false
}
