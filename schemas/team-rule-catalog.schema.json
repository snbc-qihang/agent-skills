{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/team-rule-catalog.schema.json",
  "type": "object",
  "required": ["id", "version", "profile_id", "sources", "rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "digest", "topics"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^git-blob:[0-9a-f]{40}$"},
          "topics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "guidance", "source_refs", "target_refs", "capability_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*[0-9]$"},
          "category": {"type": "string", "minLength": 1},
          "guidance": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "target_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "capability_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
