{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/investigation-record.schema.json",
  "type": "object",
  "$defs": {
    "investigation_request": {
      "type": "object",
      "required": ["id", "run_id", "question", "reason", "source_scope", "reported_blocking", "mode", "estimated_cost", "stop_conditions", "evidence_requirements", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["official_docs", "source_repository", "standards", "issues", "internal_repository", "runtime_evidence"]}},
        "reported_blocking": {"type": "boolean", "description": "Observation metadata only; it never pauses or blocks the governed run."},
        "mode": {"enum": ["auto_readonly", "suggest_then_run", "guided", "disabled"]},
        "estimated_cost": {"enum": ["low", "medium", "high"]},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["proposed", "approved", "running", "completed", "declined", "blocked"]}
      },
      "additionalProperties": false
    }
  },
  "required": ["request", "decision_ref", "evidence_refs", "remaining_source_scope", "current_source_scope", "transition_history", "updated_at", "revision"],
  "properties": {
    "request": {"$ref": "#/$defs/investigation_request"},
    "decision_ref": {"type": ["string", "null"], "minLength": 1},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "remaining_source_scope": {"type": "array", "uniqueItems": true, "items": {"enum": ["official_docs", "source_repository", "standards", "issues", "internal_repository", "runtime_evidence"]}},
    "current_source_scope": {"type": "array", "uniqueItems": true, "items": {"enum": ["official_docs", "source_repository", "standards", "issues", "internal_repository", "runtime_evidence"]}},
    "transition_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from_status", "to_status", "action", "decision_ref", "observed_at"],
        "properties": {
          "from_status": {"type": "string"},
          "to_status": {"enum": ["proposed", "approved", "running", "completed", "declined", "blocked"]},
          "action": {"enum": ["propose", "approve", "decline", "start", "complete", "block", "advance_step"]},
          "decision_ref": {"type": ["string", "null"], "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
