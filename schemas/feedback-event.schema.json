{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/feedback-event.schema.json",
  "type": "object",
  "required": [
    "event_id", "run_id", "task_id", "node_id", "turn_id", "event_type",
    "severity", "source", "symptom", "expected_behavior", "observed_behavior",
    "human_action", "evidence_refs", "recurrence_key", "resolution",
    "reusable_candidate", "sensitivity", "observed_at"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "node_id": {"type": ["string", "null"]},
    "turn_id": {"type": ["string", "null"]},
    "event_type": {"enum": ["blocker", "human_correction", "rework", "quality_regression", "tool_failure", "scope_change", "positive_outcome"]},
    "severity": {"enum": ["info", "low", "medium", "high", "blocker"]},
    "source": {"enum": ["stop_hook", "tool_hook", "runtime", "human", "ci", "canary"]},
    "symptom": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "observed_behavior": {"type": "string", "minLength": 1},
    "human_action": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recurrence_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "resolution": {"enum": ["open", "repaired", "accepted", "wont_fix"]},
    "reusable_candidate": {"type": "boolean"},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
