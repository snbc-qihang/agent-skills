{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/investigation-decision-grant.schema.json",
  "type": "object",
  "required": ["grant_id", "broker_id", "audience", "action", "run_id", "investigation_id", "run_revision", "decision", "selected_mode", "allowed_source_scope", "max_cost", "issued_at", "expires_at", "actor_ref", "nonce", "token"],
  "properties": {
    "grant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "broker_id": {"type": "string", "minLength": 1},
    "audience": {"const": "engineering-assistant"},
    "action": {"const": "investigation.select_mode"},
    "run_id": {"type": "string", "minLength": 1},
    "investigation_id": {"type": "string", "minLength": 1},
    "run_revision": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["approve", "decline"]},
    "selected_mode": {"enum": ["auto_readonly", "suggest_then_run", "guided", "disabled"]},
    "allowed_source_scope": {"type": "array", "uniqueItems": true, "items": {"enum": ["official_docs", "source_repository", "standards", "issues", "internal_repository", "runtime_evidence"]}},
    "max_cost": {"enum": ["low", "medium", "high"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "actor_ref": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 16},
    "token": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
