{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/skill-spec.schema.json",
  "type": "object",
  "required": ["id", "version", "invocation_mode", "leading_words", "capabilities", "inputs", "completion_criteria", "context_pointers", "policy_refs", "risk_class", "source_path"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "invocation_mode": {"enum": ["user", "model", "both", "internal"]},
    "description": {"type": ["string", "null"]},
    "leading_words": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "evidence_kinds"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "evidence_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "context_pointers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when", "path", "purpose"],
        "properties": {
          "when": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk_class": {"enum": ["read_only", "reversible_write", "high_risk", "external_action"]},
    "source_path": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"invocation_mode": {"const": "user"}}}, "then": {"properties": {"description": {"type": "null"}}}},
    {"if": {"properties": {"invocation_mode": {"enum": ["model", "both"]}}}, "then": {"required": ["description"], "properties": {"description": {"type": "string", "minLength": 1}}}}
  ],
  "additionalProperties": false
}
