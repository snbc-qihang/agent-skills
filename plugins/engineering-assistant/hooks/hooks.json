{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/engineering-assistant/bin/ea\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__engineering_assistant__engineering_assistant_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/engineering-assistant/bin/ea\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__engineering_assistant__engineering_assistant_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/engineering-assistant/bin/ea\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/engineering-assistant/bin/ea\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
