{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["record_id", "run_id", "run_revision", "approval_id", "decision", "scope", "actor_ref", "reason", "recorded_at", "source"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_revision": {"type": "integer", "minimum": 0},
    "approval_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected"]},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actor_ref": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "source": {"enum": ["user_confirmation", "conversation"]}
  },
  "additionalProperties": false
}
