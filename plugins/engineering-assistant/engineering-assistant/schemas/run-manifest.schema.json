{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "product_version", "build_version", "run_id", "task_id", "intent", "route_decision", "profile_id", "started_at"],
  "properties": {
    "schema_version": {"const": "2"},
    "product_version": {"type": "string", "minLength": 1},
    "build_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "intent": {"type": "object"},
    "route_decision": {"type": "object"},
    "profile_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
