{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/flow-spec.schema.json",
  "type": "object",
  "required": ["id", "version", "entry_conditions", "nodes", "terminal_conditions", "policy_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "entry_conditions": {"type": "array", "items": {"type": "string"}},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capability", "depends_on", "when", "completion_criteria", "policy_refs"],
        "properties": {
          "id": {"type": "string"},
          "capability": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "when": {"type": "string"},
          "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          ,"evidence_kinds": {"type": "array", "items": {"enum": ["source", "test", "build", "browser", "ci", "review", "approval", "external_state"]}, "uniqueItems": true}
          ,"evidence_scope_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "terminal_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
