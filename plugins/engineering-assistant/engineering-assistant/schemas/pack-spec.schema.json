{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/schemas/pack-spec.schema.json",
  "type": "object",
  "required": ["id", "version", "activation", "capabilities", "policy_refs", "source_path"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "activation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
