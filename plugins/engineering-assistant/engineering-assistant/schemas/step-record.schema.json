{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "sequence", "run_id", "node_id", "input_revision", "output_revision", "result", "gate", "node_output", "state_after", "recorded_at"],
  "properties": {
    "schema_version": {"const": "2"},
    "sequence": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "input_revision": {"type": "integer", "minimum": 0},
    "output_revision": {"type": "integer", "minimum": 0},
    "result": {"type": "object"},
    "gate": {"type": "object"},
    "node_output": {"type": ["object", "null"]},
    "state_after": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
